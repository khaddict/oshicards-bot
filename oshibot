    regular)
      GAP_MIN=$(rand 90 130); GAP_MAX=$(rand 170 240); SLEEP_MIN=$(rand 420 510)
      QUIET_LEN=$(rand 180 300); SKIP_CHANCE=$(rand 8 15)
      LIGHT_DAY_CHANCE=$(rand 8 14); PARTIAL_CHANCE=$(rand 10 20) ;;
    grinder)
      GAP_MIN=$(rand 65 85); GAP_MAX=$(rand 105 120); SLEEP_MIN=$(rand 360 450)
      QUIET_LEN=0; SKIP_CHANCE=$(rand 3 8)
      LIGHT_DAY_CHANCE=$(rand 3 7); PARTIAL_CHANCE=$(rand 3 8) ;;
    nonstop)
      GAP_MIN=$(rand 65 85); GAP_MAX=$(rand 105 120); SLEEP_MIN=0
      QUIET_LEN=0; SKIP_CHANCE=$(rand 2 5)
      LIGHT_DAY_CHANCE=0; PARTIAL_CHANCE=$(rand 2 5) ;;
