mission_exchange() {
  local ids
  spare_copies >/dev/null
  ids=$(spare_rarity common | shuf | head -5 | jq -Rn '[inputs | tonumber]')
  if (( $(jq length <<<"$ids") < 5 )); then
    rm -f "$SPARE_HTML"; warn "mission exchange: fewer than 5 spare commons"; return 1
  fi
  idle "$(rand 4 10)"
  if ! call_action exchangeDuplicatesAction "/$LOCALE/exchange" "[$ids]" "$SPARE_HTML" ||
      [[ -n $(jq -r '.error // empty' <<<"$ACT_BODY" 2>/dev/null) ]]; then
    rm -f "$SPARE_HTML"; warn "mission exchange: refused ($(jq -r '.error // empty' <<<"$ACT_BODY" 2>/dev/null))"; return 1
  fi
  rm -f "$SPARE_HTML"
  MISSION_DONE+="${MISSION_DONE:+, }5 commons exchanged for $(jq -r '.card.name // "a card"' <<<"$ACT_BODY")"
}

# $1 = how many copies are still needed
mission_recycle() {
  local want=$1 copy n=0 gems=0 g list
  list=$(mktemp)
  spare_copies >"$list"
  rm -f "$SPARE_HTML"
  visit_page "/$LOCALE/collection"
  SPARE_HTML=$PAGE_HTML
  for copy in $(cut -f1 "$list" | head -"$want"); do
    idle "$(rand 2 6)"
    call_action recycleCopyAction "/$LOCALE/collection" "[$copy]" "$SPARE_HTML" || continue
    [[ -z $(jq -r '.error // empty' <<<"$ACT_BODY" 2>/dev/null) ]] || continue
    g=$(jq -r '.gems // 0' <<<"$ACT_BODY"); [[ $g =~ ^[0-9]+$ ]] || g=0
    n=$((n + 1)); gems=$((gems + g))
  done
  rm -f "$SPARE_HTML" "$list"
  (( n > 0 )) || { warn "mission recycle: nothing recycled"; return 1; }
  MISSION_DONE+="${MISSION_DONE:+, }$n duplicates recycled (+$gems gems)"
}

# does the unfinished missions listed in DO_MISSIONS, from the missions page saved in $1
MISSION_DONE=""
do_missions() {
  local html=$1 line kind left rc
  [[ -n $DO_MISSIONS ]] || return 0
  MISSION_DONE=""
  while IFS=$'\t' read -r kind left; do
    case $kind in
      banner) [[ " $DO_MISSIONS " == *" banner "* ]] || continue; mission_banner ;;
      wishlist) [[ " $DO_MISSIONS " == *" wishlist "* ]] || continue; mission_wishlist ;;
      chat | message*) [[ " $DO_MISSIONS " == *" chat "* ]] || continue; mission_chat ;;
      *bid* | auction*) [[ " $DO_MISSIONS " == *" auction "* ]] || continue; mission_auction ;;
      market_sell | *sell*) [[ " $DO_MISSIONS " == *" sell "* ]] || continue; mission_sell ;;
      exchange*) [[ " $DO_MISSIONS " == *" exchange "* ]] || continue; mission_exchange ;;
      recycle*) [[ " $DO_MISSIONS " == *" recycle "* ]] || continue; mission_recycle "$left" ;;
      *) continue ;;
    esac
    rc=$?
    (( rc == 3 )) && return 3
    sleep "$(rand 5 20)"
  done < <(page_stream "$html" | grep -oP '\{"code":"[a-z0-9_]+","done":false,[^{}]*?"claimed":false,"progress":\d+' |
    sed 's/$/}/' | jq -r '[.kind, (.target - .progress)] | @tsv' 2>/dev/null | awk '!s[$1]++')
  if [[ -n $MISSION_DONE ]]; then
    ok "missions done: $MISSION_DONE"
    digest_add "Missions done: $MISSION_DONE"
  fi
  return 0
}

# ---------- missions ----------

# claims every mission that is finished and not claimed yet. 0 = ok, 2 = dead session, 3 = safety stop
claim_missions() {
  local path="/$LOCALE/missions" html rc code n=0 gems=0 bonus=0 g b e
  if [[ -f $HALT ]]; then
    err "stopped earlier: $(<"$HALT") (run: ${B}oshibot resume${R})"; return 3
  fi
  load_browser
  ensure_session; rc=$?
  (( rc == 2 )) && return 2
  (( rc == 1 )) && return 0
  visit_page "$path"
  html=$PAGE_HTML
  state_set MISSIONS_NEXT $(( $(now) + $(rand 7200 14400) ))
  case $PAGE_CODE in
    200) ;;
    403 | 429) rm -f "$html"; halt "the missions page answered HTTP $PAGE_CODE, the site may be blocking this tool"; return 3 ;;
    *) rm -f "$html"; warn "missions page unreachable ($PAGE_CODE)"; return 0 ;;
  esac
  if [[ -n $DO_MISSIONS && $(state_get MISSIONS_DONE_AT 0) -lt $(( $(now) - 3600 )) ]]; then
    state_set MISSIONS_DONE_AT "$(now)"
    do_missions "$html" || { rm -f "$html"; return 3; }
    if [[ -n $MISSION_DONE ]]; then
      rm -f "$html"; sleep "$(rand 5 15)"
      visit_page "$path"; html=$PAGE_HTML
    fi
  fi
  for code in $(grep -oP '\{\\"code\\":\\"\K[a-z0-9_]+(?=\\",\\"done\\":true,[^{}]*?\\"claimed\\":false)' "$html" | sort -u); do
    idle "$(rand 1 4)"
    if ! call_action claimMissionAction "$path" "$(jq -nc --arg c "$code" '[$c]')" "$html"; then
      warn "mission $code: claim refused (HTTP $ACT_STATUS)"; continue
    fi
    e=$(jq -r '.error // empty' <<<"$ACT_BODY" 2>/dev/null)
    if [[ -n $e ]]; then
      warn "mission $code: $e"; continue
    fi
    g=$(jq -r '.gems // 0' <<<"$ACT_BODY" 2>/dev/null); b=$(jq -r '.bonus // 0' <<<"$ACT_BODY" 2>/dev/null)
    [[ $g =~ ^[0-9]+$ ]] || g=0
    [[ $b =~ ^[0-9]+$ ]] || b=0
    ok "mission claimed: $code, +$g gems$( ((b > 0)) && echo ", +$b bonus booster(s)")"
    n=$((n + 1)); gems=$((gems + g)); bonus=$((bonus + b))
  done
  rm -f "$html"
  sleep "$(rand 5 20)"
  claim_rewards || return $?
  if (( n > 0 )); then
    (( bonus > 0 )) && state_set BONUS $(( $(state_get BONUS 0) + bonus ))
    digest_add "Missions claimed: $n, +$gems gems$( ((bonus > 0)) && echo ", +$bonus bonus booster(s)")"
  else
    log "missions: nothing to claim"
  fi
  return 0
}

# ---------- other rewards ----------

REWARDS_SUMMARY=""

# opens page $1, and when grep pattern $2 matches its data, calls action $3 with arguments $4.
# $5 = label. Adds what was won to REWARDS_SUMMARY. 0 = ok, 3 = safety stop
claim_on_page() {
  local path=$1 pattern=$2 action=$3 args=$4 label=$5 html data r g b f
  visit_page "$path"
  html=$PAGE_HTML
  case $PAGE_CODE in
    200) ;;
    403 | 429) rm -f "$html"; halt "the page $path answered HTTP $PAGE_CODE, the site may be blocking this tool"; return 3 ;;
    *) rm -f "$html"; warn "$label: page unreachable ($PAGE_CODE)"; return 0 ;;
  esac
  data=$(page_stream "$html")
  if ! grep -qP -- "$pattern" <<<"$data"; then
    rm -f "$html"; return 0
  fi
  idle "$(rand 2 6)"
  if ! call_action "$action" "$path" "$args" "$html"; then
    rm -f "$html"
    [[ $ACT_STATUS == 403 || $ACT_STATUS == 429 ]] && { halt "claiming $label answered HTTP $ACT_STATUS"; return 3; }
    warn "$label: claim refused (HTTP $ACT_STATUS)"; return 0
  fi
  rm -f "$html"
  r=$(jq -c '.result // .' <<<"$ACT_BODY" 2>/dev/null)
  if [[ -n $(jq -r '.error // empty' <<<"$r" 2>/dev/null) ]]; then
    warn "$label: $(jq -r .error <<<"$r")"; return 0
  fi
  g=$(jq -r '.gems // 0' <<<"$r" 2>/dev/null); b=$(jq -r '.bonus // 0' <<<"$r" 2>/dev/null); f=$(jq -r '.free // 0' <<<"$r" 2>/dev/null)
  [[ $g =~ ^[0-9]+$ ]] || g=0
  [[ $b =~ ^[0-9]+$ ]] || b=0
  [[ $f =~ ^[0-9]+$ ]] || f=0
  (( b > 0 )) && state_set BONUS $(( $(state_get BONUS 0) + b ))
  label="$label: +$g gems$( ((b > 0)) && echo ", +$b bonus booster(s)")$( ((f > 0)) && echo ", free stock +$f")"
  ok "claimed $label"
  REWARDS_SUMMARY+="${REWARDS_SUMMARY:+; }$label"
  return 0
}

# claims the rewards waiting outside missions: weekly boss, season pass, achievements, completed anime.
# Once a day. 0 = ok, 2 = dead session, 3 = safety stop
claim_rewards() {
  local rc
  (( CLAIM_MISSIONS )) || return 0
  [[ $(state_get REWARDS_DAY "") == "$(paris_day)" ]] && return 0
  load_browser
  ensure_session; rc=$?
  (( rc == 2 )) && return 2
  (( rc == 1 )) && return 0
  REWARDS_SUMMARY=""
  claim_on_page "/$LOCALE/games" '"claimable":\{"gems":\d+,"count":[1-9]' gameBossClaimAction '[]' "weekly boss" || return 3
  sleep "$(rand 3 10)"
  claim_on_page "/$LOCALE/pass" '"me":\{.*?"claimed":(\d+),"reached":(?!\1[,}])\d+|"repeat_claimed":(\d+),"repeat_reached":(?!\2[,}])\d+' claimPassAction '[null]' "season pass" || return 3
  sleep "$(rand 3 10)"
  claim_on_page "/$LOCALE/achievements" '"claimable":true' claimAchievementsAction '[]' "achievements" || return 3
  sleep "$(rand 3 10)"
  claim_on_page "/$LOCALE/collection/anime" '"franchiseId":null,"count":[1-9]' claimAnimeAction '[null]' "completed anime" || return 3
  state_set REWARDS_DAY "$(paris_day)"
  [[ -n $REWARDS_SUMMARY ]] && digest_add "Rewards: $REWARDS_SUMMARY"
  return 0
}

missions_due() { (( CLAIM_MISSIONS )) && (( $(now) >= $(state_get MISSIONS_NEXT 0) )); }

# ---------- schedule ----------

BED=0
WAKE=0
DAY_FACTOR=10

is_weekend_night() { [[ $(date -d "@$1" +%u) -ge 6 ]]; }

# $1 = midnight the night is attached to
draw_night() {
  local shift=0
  is_weekend_night "$1" && shift=$WEEKEND_SHIFT
  BED=$(( $1 + (BED_BASE + shift) * 60 + $(rand 0 $((NIGHT_JITTER * 120))) - NIGHT_JITTER * 60 ))
  WAKE=$(( BED + SLEEP_MIN * 60 + $(rand 0 2400) - 1200 ))
  # no sleep: the night is empty and only marks the change of day
  (( SLEEP_MIN > 0 )) || WAKE=$BED
}

# upcoming night, or the current one when started before wake-up
plan_night() {
  local t=$(now) base prev=$WAKE i
  base=$(date -d "$(date -d "@$t" +%F) 00:00" +%s)
  draw_night "$base"
  # skip nights that are already over, or the one we just woke up from
  for i in 1 2 3; do
    (( WAKE <= t )) || (( prev > 0 && BED < prev + 14400 )) || break
    base=$(date -d "$(date -d "@$base" +%F) tomorrow" +%s)
    draw_night "$base"
  done
  DAY_FACTOR=10
  (( $(rand 1 100) <= LIGHT_DAY_CHANCE )) && DAY_FACTOR=$(rand 25 40)
  state_set BED "$BED"; state_set WAKE "$WAKE"; state_set LIGHT "$(( DAY_FACTOR > 10 ))"
}

quiet_adjust() {
  local target=$1 qs
  if (( QUIET_LEN > 0 )) && (( $(date -d "@$target" +%u) <= 5 )); then
    qs=$(( $(date -d "$(date -d "@$target" +%F) 00:00" +%s) + QUIET_START * 60 ))
    if (( target >= qs && target < qs + QUIET_LEN * 60 )); then
      target=$(( qs + QUIET_LEN * 60 + $(rand 0 1500) ))
    fi
  fi
  echo "$target"
}

# $1 = wanted delay in seconds, prints the epoch of the next session
next_session_at() {
  local t=$(now) target
  target=$((t + $1))
  if (( target >= BED && target < WAKE )); then
    # one last session at bedtime if worth it, otherwise at wake-up
    if (( BED > t + 2400 )); then target=$BED; else target=$WAKE; fi
  else
    target=$(quiet_adjust "$target")
  fi
  echo "$target"
}

pause_until() {
  local p=0
  [[ -f $PAUSE ]] && p=$(<"$PAUSE")
  echo "${p:-0}"
}

send_recap() {
  (( DAILY_RECAP )) && [[ -n $WEBHOOK ]] || return 0
  local d
  d=$(date -d "@$(( $(now) - 86400 ))" +%F)
  load_stats
  local msg="" news=""
  (( ${S_PACKS[$d]:-0} > 0 )) && msg="**Yesterday:** $(recap_line "$d")."
  if [[ -f $DIGEST ]]; then
    news=$(awk -F'\t' -v d="$d" '$1 <= d { print "- " $2 }' "$DIGEST")
    awk -F'\t' -v d="$d" '$1 > d' "$DIGEST" >"$DIGEST.tmp" && mv "$DIGEST.tmp" "$DIGEST"
  fi
  [[ -n $news ]] && msg+="${msg:+$'\n'}$news"
  [[ -n $msg ]] && discord_text "${msg:0:1900}"
  return 0
}

cmd_run() {
  local gap target first=1 last want pu fill rc
  ensure_profile
  ensure_device
  load_browser
  has_browser || warn "no browser identity saved, using a generic one (run: oshibot browser)"
  [[ -f $HALT ]] && { err "stopped earlier: $(<"$HALT") (run: ${B}oshibot resume${R})"; exit 3; }
  plan_night
  log "loop started with the ${B}$PRESET${R} preset"
  while true; do
    if (( $(now) >= WAKE )); then
      plan_night
      send_recap
    fi
    pu=$(pause_until)
    if (( pu > $(now) )); then
      log "paused until $(date -d "@$pu" '+%a %d %b %H:%M')"
      state_set NEXT "$pu"
      gap=$(( pu - $(now) ))
      sleep $(( gap < 21600 ? gap : 21600 ))
      first=1
      continue
    fi
    if (( first )); then
      first=0
      gap=$(rand 60 300)
      last=$(state_get LAST_SESSION 0)
      (( last + GAP_MIN * 60 - $(now) > gap )) && gap=$(( last + GAP_MIN * 60 - $(now) ))
    else
      gap=$(( $(rand $GAP_MIN $GAP_MAX) * 6 * DAY_FACTOR + $(rand 0 59) ))
      # the top presets come back before the stock is full, whatever its size
      fill=$(( $(max_packs) * $(regen_minutes) * 60 ))
      if [[ $PRESET == grinder || $PRESET == nonstop ]] && (( DAY_FACTOR == 10 && gap > fill )); then
        gap=$(( fill - $(rand 0 420) ))
      fi
      if (( $(rand 1 100) <= SKIP_CHANCE )); then
        gap=$(( gap + $(rand $SKIP_EXTRA_MIN $SKIP_EXTRA_MAX) * 60 ))
      fi
    fi
    target=$(next_session_at "$gap")
    state_set NEXT "$target"
    log "next session at $(date -d "@$target" '+%a %H:%M') (in $(( (target - $(now)) / 60 )) min)$( ((SLEEP_MIN > 0)) && echo ", night from $(date -d "@$BED" +%H:%M) to $(date -d "@$WAKE" +%H:%M)")$( ((DAY_FACTOR > 10)) && echo ', light day')"
    gap=$(( target - $(now) ))
    sleep $(( gap > 0 ? gap : 0 ))
    (( $(pause_until) > $(now) )) && continue

    want=$(max_packs)
    (( want > 4 && $(rand 1 100) <= PARTIAL_CHANCE )) && want=$(rand 3 $(( want * 3 / 4 )))
    locked_session "$want"; rc=$?
    if (( rc == 0 )) && games_due; then
      sleep "$(rand 8 45)"
      locked play_games; rc=$?
    elif (( rc == 0 )) && missions_due; then
      sleep "$(rand 5 30)"
      locked claim_missions; rc=$?
    fi
    case $rc in
      2)
        discord_text "oshibot lost its oshicards session: $(session_dead_reason)"
        exit 2 ;;
      3) exit 3 ;;
    esac
  done
}

# ---------- commands ----------

restart_service() {
  systemctl is-enabled -q "$SERVICE" 2>/dev/null || return 0
  # only the copy the service actually runs may restart it
  grep -qF "ExecStart=$DIR/oshibot run" "$UNIT" 2>/dev/null || return 0
  if (( EUID == 0 )); then
    systemctl restart "$SERVICE" && ok "service restarted"
  else
    warn "restart the service to apply: ${B}sudo systemctl restart $SERVICE${R}"
  fi
}

# when run with sudo, hand the data files back to the owner of the directory
fix_owner() {
  (( EUID == 0 )) || return 0
  chown -f "$(stat -c %U:%G "$DIR")" "$SESSION" "$DEVICE" "$PROFILE" "$CONFIG" "$STATE" "$HISTORY" "$PAUSE" "$HALT" "$LOCK" 2>/dev/null
  return 0
}

read_paste() {
  local input=${1:-}
  if [[ -n $input && -f $input ]]; then
    input=$(<"$input")
  elif [[ -z $input && ! -t 0 ]]; then
    input=$(cat)
  elif [[ -z $input ]]; then
    read -r -e -p "Paste > " input
    echo >&2
  fi
  echo "$input"
}

cmd_cookie() {
  local input=${1:-} token cookie login
  if [[ -z $input && -t 0 ]]; then
    cat <<EOF
${B}How to connect your oshicards account${R}

  1. Open ${CYA}$SITE${R} in a ${B}private browsing window${R} of your usual browser and log in.
  2. Press F12, open the ${B}Console${R} tab and paste this line:

       ${GRN}$SNIPPET${R}

     (if the browser blocks pasting, type this first: allow pasting)
  3. Paste the result below and press Enter.
  4. ${B}Close the private window right away, without logging out.${R}

  ${DIM}The line copies your session cookie and your browser's identity (user agent,
  language) so the tool presents itself like your own browser.
  Why a private window, closed at once: the login must belong to oshibot alone.
  If a browser keeps using the same login, the two log each other out within hours.
  Your regular browser has its own login and is not affected.${R}

EOF
  fi
  input=$(read_paste "$input")
  cookie=$input
  if jq -e 'type == "object"' >/dev/null 2>&1 <<<"$input"; then
    cookie=$(jq -r '.cookie // ""' <<<"$input")
    save_browser "$input" && ok "browser identity saved" || warn "could not read the browser identity"
  fi
  load_browser
  token=$(extract_refresh_token "$cookie") || true
  [[ -z $token ]] && die "no $COOKIE_NAME cookie found in what you pasted"
  refresh_session "$token" || die "could not create the session (cookie expired or already used?)"
  ok "session saved for ${B}$(jq -r '.user.email // .user.id' "$SESSION")${R}"
  login=$(session_login_time)
  if (( login > 0 && $(now) - login > 1200 )); then
    warn "this login is $(( ($(now) - login) / 60 )) min old, so it is probably shared with an open browser."
    warn "They will log each other out within hours. Use a fresh private window and close it right after."
  fi
  has_browser || warn "no browser identity saved, a generic one will be used (run: oshibot browser)"
  restart_service
}

cmd_browser() {
  local input=${1:-}
  if [[ -z $input && -t 0 ]]; then
    cat <<EOF
${B}Save your browser's identity${R}

  In the browser you normally play with, press F12, open the ${B}Console${R} tab on any page and paste:

       ${GRN}$SNIPPET${R}

  Then paste the result below. Only the user agent and language are kept.

EOF
  fi
  input=$(read_paste "$input")
  save_browser "$input" || die "this is not the output of the console line"
  ok "browser identity saved: $(jq -r .browser.ua "$DEVICE")"
  restart_service
}

cmd_profile() {
  local preset=${1:-}
  if [[ -z $preset ]]; then
    ensure_profile
    show_profile
    echo
    echo "Redraw with: oshibot profile <chill|regular|grinder|nonstop>"
    return
  fi
  gen_profile "$preset"
  ok "new ${B}$preset${R} profile drawn"
  show_profile
  restart_service
}

cmd_webhook() {
  local url=${1:-}
  case $url in
    "")
      if [[ -n $WEBHOOK ]]; then echo "Webhook: ${WEBHOOK:0:60}..."; else echo "No webhook configured."; fi
      cat <<EOF

Usage: oshibot webhook <url>     save the webhook
       oshibot webhook test      send a test message
       oshibot webhook off       remove it

To create the URL: Discord > channel > Edit > Integrations > Webhooks > New Webhook > Copy Webhook URL.
EOF
      ;;
    test)
      [[ -z $WEBHOOK ]] && die "no webhook configured"
      discord_send "$(loot_payload '{"result":{"boosters":[{"cards":[{"name":"Test card","rarity":"legendary","serial":1,"series_title":"oshibot webhook test","image_url":"https://s4.anilist.co/file/anilistcdn/character/large/3437.jpg","is_new":true,"variant":null}]}]}}')"
      [[ $HTTP_STATUS == 2* ]] && ok "test message sent"
      ;;
    off)
      rm -f "$CONFIG"; ok "webhook removed"
      ;;
    https://discord.com/api/webhooks/* | https://discordapp.com/api/webhooks/* | https://*.discord.com/api/webhooks/*)
      (umask 077; printf 'WEBHOOK=%q\n' "$url" >"$CONFIG")
      WEBHOOK=$url
      ok "webhook saved, try it with: ${B}oshibot webhook test${R}"
      ;;
    *) die "invalid Discord webhook URL" ;;
  esac
}

FORCE_PACK=""
cmd_open() {
  local max n="" a
  for a in "$@"; do
    if [[ $a =~ ^[0-9]+$ ]]; then n=$a
    elif [[ $a =~ ^[a-z0-9_-]+$ ]]; then FORCE_PACK=$a
    else die "usage: oshibot open [n] [pack]"
    fi
  done
  max=$(max_packs)
  (( USE_BONUS )) && max=$(( max + $(state_get BONUS 0) ))
  n=${n:-$(max_packs)}
  (( n >= 1 && n <= max )) || die "pack count must be between 1 and $max"
  ensure_profile
  locked_session "$n"
}

cmd_friend() {
  local u=${1:-} html list
  load_browser
  ensure_session >/dev/null; (( $? == 2 )) && die "no valid session, run: oshibot cookie"
  visit_page "/$LOCALE/friends"
  html=$PAGE_HTML
  [[ $PAGE_CODE == 200 ]] || { rm -f "$html"; die "friends page unreachable (HTTP $PAGE_CODE)"; }
  list=$(page_stream "$html" | grep -oP '"friends":\K\[.*?\](?=,"(requests|conversations|incoming|outgoing|groups|sent|received)")' | head -1 |
    jq -r '.[] | [.username, .display_name] | @tsv' 2>/dev/null)
  rm -f "$html"
  if [[ -z $u ]]; then
    echo "Your friends (username, name):"
    sed 's/^/  /' <<<"${list:-  (none found)}"
    echo
    echo "Current MISSION_FRIEND: ${MISSION_FRIEND:-none}. Set one with: oshibot friend <username>"
    return 0
  fi
  awk -F'\t' -v u="$u" '$1 == u { f = 1 } END { exit !f }' <<<"$list" || die "$u is not in your friends list (run: oshibot friend)"
  ensure_profile
  if grep -q '^MISSION_FRIEND=' "$PROFILE"; then
    sed -i "s/^MISSION_FRIEND=.*/MISSION_FRIEND=\"$u\"/" "$PROFILE"
  else
    printf 'MISSION_FRIEND="%s"\n' "$u" >>"$PROFILE"
  fi
  ok "the friend message mission will write to ${B}$u${R}"
  restart_service
}

cmd_packs() {
  local html list slug kind from until name mark when
  load_browser
  ensure_session >/dev/null; (( $? == 2 )) && die "no valid session, run: oshibot cookie"
  visit_page "/$LOCALE/volumes"
  html=$PAGE_HTML
  [[ $PAGE_CODE == 200 ]] || { rm -f "$html"; die "volumes page unreachable (HTTP $PAGE_CODE)"; }
  list=$(site_packs "$html")
  rm -f "$html"
  [[ -n $list ]] || die "could not read the pack list from the site"
  printf '%s%-22s %-26s %-6s %s%s\n' "$B" "Pack" "Name" "Cost" "Available" "$R"
  while IFS=$'\t' read -r slug kind from until name; do
    when="always"
    [[ $until != null ]] && when="until $(date -d "$until" '+%a %d %b %H:%M')"
    [[ $from != null ]] && ! in_window "$from" null && when="from $(date -d "$from" '+%a %d %b %H:%M')"
    mark=""
    [[ " $PACKS " == *" $slug "* ]] && mark=" ${GRN}<- in your PACKS${R}"
    [[ $kind == free ]] || { kind="${DIM}$kind${R}"; }
    printf '%-22s %s%*s %-6s %s%s\n' "$slug" "$name" $(( 26 - $(LC_ALL=C.UTF-8 bash -c 'echo ${#1}' _ "$name") )) "" "$kind" "$when" "$mark"
  done <<<"$list"
  echo
  echo "Your PACKS: ${B}$PACKS${R} (edit it in $PROFILE)"
  echo "oshibot opens the first of them that is free and available, and never packs that cost gems."
}

cmd_pause() {
  local d=${1:-} secs
  [[ $d =~ ^([0-9]+)([dhm])$ ]] || die "usage: oshibot pause <duration>, for example 3d, 12h or 45m"
  case ${BASH_REMATCH[2]} in
    d) secs=$(( BASH_REMATCH[1] * 86400 )) ;;
    h) secs=$(( BASH_REMATCH[1] * 3600 )) ;;
    m) secs=$(( BASH_REMATCH[1] * 60 )) ;;
  esac
  echo $(( $(now) + secs )) >"$PAUSE"
  ok "paused until $(date -d "@$(<"$PAUSE")" '+%a %d %b %H:%M') (cancel with: oshibot resume)"
}

cmd_resume() {
  local was=""
  [[ -f $HALT ]] && was="safety stop cleared"
  [[ -f $PAUSE ]] && was="${was:+$was, }pause cancelled"
  rm -f "$HALT" "$PAUSE"
  ok "${was:-nothing to resume}"
  restart_service
}

cmd_stats() {
  local i d total=0
  load_stats
  printf '%s%-12s %6s %6s %6s %10s %7s%s\n' "$B" Day Packs Rare Epic Legendary Mythic "$R"
  for i in 6 5 4 3 2 1 0; do
    d=$(date -d "@$(( $(now) - i * 86400 ))" +%F)
    printf '%-12s %6s %6s %6s %10s %7s\n' "$d" "${S_PACKS[$d]:-0}" "${S_RARE[$d]:-0}" "${S_EPIC[$d]:-0}" "${S_LEG[$d]:-0}" "${S_MYTH[$d]:-0}"
  done
  for d in "${!S_PACKS[@]}"; do total=$(( total + S_PACKS[$d] )); done
  echo
  echo "All time: $total packs over ${#S_PACKS[@]} day(s)"
}

cmd_status() {
  local exp left pu next
  if [[ -f $SESSION ]]; then
    exp=$(jq -r '.expires_at // 0' "$SESSION"); left=$(( exp - $(now) ))
    echo "Session : ${GRN}$(jq -r '.user.email // .user.id' "$SESSION")${R} (token $( ((left > 0)) && echo "valid for $((left / 60)) more min" || echo "due for renewal on next run"), renewed automatically)"
  else
    echo "Session : ${RED}none${R} (run: oshibot cookie)"
  fi
  echo "Browser : $(has_browser && echo "${GRN}$(jq -r '.browser.ua' "$DEVICE" | grep -oE '(Chrome|Firefox|Version)/[0-9]+' | tail -1)${R}, language $(jq -r .browser.accept_language "$DEVICE")" || echo "${YEL}generic${R} (run: oshibot browser)")"
  echo "Profile : $([[ -n $PRESET ]] && echo "${GRN}$PRESET${R}, sessions every $GAP_MIN to $GAP_MAX min (details: oshibot profile)" || echo "${YEL}not drawn yet${R} (run: oshibot profile <chill|regular|grinder|nonstop>)")"
  echo "Packs   : $PACKS$(p=$(state_get PACK ""); [[ -n $p ]] && echo " (opening $p)")"
  echo "Stock   : $([[ -n $(state_get FREE_MAX "") ]] && echo "up to $(max_packs) free boosters, one every $(regen_minutes) min, $(state_get BONUS 0) bonus left (read from your account)" || echo "not known yet, read from the site at the first opening")"
  echo "Login   : $([[ -n $(state_get LOGIN_DAY "") ]] && echo "streak day $(state_get LOGIN_DAY ""), $([[ $(state_get LOGIN_DATE "") == "$(date +%F)" ]] && echo "${GRN}claimed today${R}" || echo "not claimed yet today")" || echo "not known yet")"
  if [[ -n $PLAY_GAMES ]]; then
    local g line=""
    for g in $PLAY_GAMES; do
      line+="${line:+ | }$g: $([[ $(state_get "GAME_${g}_DAY" "") == "$(paris_day)" ]] && echo "${GRN}$(state_get "GAME_${g}_RESULT" "played")${R}" || echo "to play")"
    done
    echo "Games   : $line"
  fi
  (( CLAIM_MISSIONS )) && echo "Missions: claimed automatically, next check $(n=$(state_get MISSIONS_NEXT 0); ((n > $(now))) && date -d "@$n" +%H:%M || echo "at the next session")"
  echo "Webhook : $([[ -n $WEBHOOK ]] && echo "${GRN}configured${R}" || echo "${YEL}not configured${R} (run: oshibot webhook <url>)")"
  if [[ -f $UNIT ]]; then
    echo "Service : $(systemctl is-active "$SERVICE" 2>/dev/null)"
  else
    echo "Service : ${YEL}not installed${R} (run: oshibot install)"
  fi
  [[ -f $HALT ]] && echo "${RED}Stopped${R} : $(<"$HALT") (run: oshibot resume)"
  pu=$(pause_until)
  (( pu > $(now) )) && echo "${YEL}Paused${R}  : until $(date -d "@$pu" '+%a %d %b %H:%M') (run: oshibot resume)"
  next=$(state_get NEXT 0)
  if [[ -f $UNIT ]] && (( next > $(now) )); then
    echo "Next    : session at $(date -d "@$next" '+%a %H:%M')$( ((SLEEP_MIN > 0)) && echo ", night from $(date -d "@$(state_get BED 0)" +%H:%M) to $(date -d "@$(state_get WAKE 0)" +%H:%M)")$([[ $(state_get LIGHT 0) == 1 ]] && echo ', light day')"
  fi
  load_stats
  echo "Today   : $(recap_line "$(date +%F)")"
}

cmd_install() {
  (( EUID == 0 )) || die "must be run as root"
  command -v systemctl >/dev/null || die "systemd not found, run the loop yourself with: oshibot run"
  [[ -f $SESSION ]] || die "set up the session first: oshibot cookie"
  ensure_profile
  fix_owner
  ln -sf "$DIR/oshibot" /usr/local/bin/oshibot
  cat >"$UNIT" <<EOF
[Unit]
Description=Automatic oshicards free booster opening
After=network-online.target
Wants=network-online.target

[Service]
User=$(stat -c %U "$DIR")
ExecStart=$DIR/oshibot run
Restart=on-failure
RestartSec=60
RestartPreventExitStatus=2 3

[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload
  systemctl enable "$SERVICE" >/dev/null 2>&1
  systemctl restart "$SERVICE" || die "could not start the service"
  ok "service running, follow it with: ${B}oshibot logs${R}"
}

cmd_uninstall() {
  (( EUID == 0 )) || die "must be run as root"
  systemctl disable --now "$SERVICE" >/dev/null 2>&1
  rm -f "$UNIT" /usr/local/bin/oshibot
  systemctl daemon-reload
  ok "service removed (session and settings kept in $DIR)"
}

cmd_setup() {
  local preset url a
  [[ -t 0 ]] || die "setup is interactive, run it in a terminal"
  echo "${B}Step 1/4: account${R}"; echo
  if [[ -f $SESSION ]]; then
    read -r -p "A session already exists for $(jq -r '.user.email // .user.id' "$SESSION"). Replace it? [y/N] > " a
    [[ $a == [yY]* ]] && cmd_cookie
  else
    cmd_cookie
  fi
  echo; echo "${B}Step 2/4: how much do you want to play?${R}"; echo
  preset=$(choose_preset 3>&1 >/dev/tty)
  gen_profile "$preset"
  ok "${B}$preset${R} profile drawn for this install"
  echo; echo "${B}Step 3/4: Discord notifications${R}"; echo
  read -r -p "Webhook URL (Enter to skip) > " url
  if [[ -n $url ]]; then
    cmd_webhook "$url" && cmd_webhook test
  fi
  echo; echo "${B}Step 4/4: background service${R}"; echo
  if (( EUID == 0 )) && command -v systemctl >/dev/null; then
    read -r -p "Install and start the service now? [Y/n] > " a
    [[ $a == [nN]* ]] || cmd_install
  else
    echo "Run ${B}sudo $DIR/oshibot install${R} to start the background loop."
  fi
  echo; cmd_status
}

cmd_help() {
  local c=$CYA d=$DIM
  cat <<EOF

  ${B}oshibot${R}  auto pack opener for oshicards
  ${d}Opens your free boosters at a human pace. Never spends gems.${R}

  ${B}${YEL}GET STARTED${R}
    ${c}oshibot setup${R}                 guided setup, runs the four steps below for you
     ${d}├─${R} ${c}oshibot cookie${R}            ${d}1.${R} connect your account
     ${d}├─${R} ${c}oshibot profile${R} <preset>  ${d}2.${R} pick a play style: chill, regular, grinder, nonstop
     ${d}├─${R} ${c}oshibot webhook${R} <url>     ${d}3.${R} Discord alerts for legendary and mythic pulls
     ${d}└─${R} ${c}oshibot install${R}           ${d}4.${R} start the background service

  ${B}${YEL}EVERY DAY${R}
    ${c}oshibot status${R}                account, profile, next session, today's pulls
    ${c}oshibot stats${R}                 packs and rarities over the last 7 days
    ${c}oshibot open${R} [n] [pack]       play one session now (whole free stock, or n packs)
    ${c}oshibot packs${R}                 list the site's packs and which ones you open
    ${c}oshibot games${R} [name...]       play today's mini-games now: anime, rarer, memory, quiz
    ${c}oshibot missions${R}              do and claim the missions
    ${c}oshibot friend${R} [username]     list your friends, or pick the one for the message mission
    ${c}oshibot pause${R} <duration>      take a break: 3d, 12h, 45m
    ${c}oshibot resume${R}                end a break, or restart after a safety stop
    ${c}oshibot logs${R}                  follow what the service is doing

  ${B}${YEL}SETTINGS${R}
    ${c}oshibot profile${R}               show your current play style
    ${c}oshibot browser${R}               refresh your browser's identity, keeps the session
    ${c}oshibot webhook${R} test|off      send a test message, or remove the webhook

  ${B}${YEL}SERVICE${R}
    ${c}oshibot uninstall${R}             stop and remove the service
    ${c}oshibot run${R}                   run the loop in the foreground

  ${d}If the site answers anything unexpected, oshibot stops itself and alerts you on Discord.${R}

EOF
}

main() {
  local cmd=${1:-help}
  shift || true
  trap fix_owner EXIT
  case $cmd in
    setup) cmd_setup ;;
    cookie) cmd_cookie "$@" ;;
    browser) cmd_browser "$@" ;;
    profile) cmd_profile "$@" ;;
    webhook) cmd_webhook "$@" ;;
    open) cmd_open "$@" ;;
    packs) cmd_packs ;;
    friend) cmd_friend "$@" ;;
    games) ensure_profile; locked play_games "$@" ;;
    missions) ensure_profile; locked claim_missions ;;
    pause) cmd_pause "$@" ;;
    resume) cmd_resume ;;
    stats) cmd_stats ;;
    run) cmd_run ;;
    status) cmd_status ;;
    install) cmd_install ;;
    uninstall) cmd_uninstall ;;
    logs) exec journalctl -u "$SERVICE" -f -n 50 -o cat ;;
    help | -h | --help) cmd_help ;;
    *) err "unknown command: $cmd"; cmd_help; exit 1 ;;
  esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi
