  esac
  PRESET=$preset
  BED_BASE=$(( $(rand 0 240) - 90 ))
  NIGHT_JITTER=$(rand 25 70)
  WEEKEND_SHIFT=$(rand 20 110)
  QUIET_START=$(rand 510 780)
  pmin=$(rand 7 14)
  PACK_PAUSE_MIN=$pmin
  PACK_PAUSE_MAX=$(( pmin + $(rand 10 22) ))
  LONG_PAUSE_CHANCE=$(rand 8 22)
  LONG_PAUSE_MAX=$(rand 60 150)
  SKIP_EXTRA_MIN=$(rand 30 60)
  SKIP_EXTRA_MAX=$(( SKIP_EXTRA_MIN + $(rand 20 70) ))
  cat >"$PROFILE" <<EOF
# Drawn at random for this install. Edit freely, or redraw with: oshibot profile <preset>
PRESET=$PRESET

# minutes between two sessions
GAP_MIN=$GAP_MIN
GAP_MAX=$GAP_MAX
# % of sessions pushed back by SKIP_EXTRA minutes
SKIP_CHANCE=$SKIP_CHANCE
SKIP_EXTRA_MIN=$SKIP_EXTRA_MIN
SKIP_EXTRA_MAX=$SKIP_EXTRA_MAX
# % of days played lightly, % of sessions that leave part of the stock
LIGHT_DAY_CHANCE=$LIGHT_DAY_CHANCE
PARTIAL_CHANCE=$PARTIAL_CHANCE

# night: bedtime in minutes after midnight (negative = before), sleep length in minutes,
# daily jitter in minutes, extra minutes on Friday and Saturday nights
BED_BASE=$BED_BASE
SLEEP_MIN=$SLEEP_MIN
NIGHT_JITTER=$NIGHT_JITTER
WEEKEND_SHIFT=$WEEKEND_SHIFT

# weekday quiet block (work, school): start in minutes after midnight, length in minutes, 0 = none
QUIET_START=$QUIET_START
QUIET_LEN=$QUIET_LEN

# seconds between two packs, and % of longer pauses
PACK_PAUSE_MIN=$PACK_PAUSE_MIN
PACK_PAUSE_MAX=$PACK_PAUSE_MAX
LONG_PAUSE_CHANCE=$LONG_PAUSE_CHANCE
LONG_PAUSE_MIN=$LONG_PAUSE_MIN
LONG_PAUSE_MAX=$LONG_PAUSE_MAX

SLUG=$SLUG
DAILY_RECAP=$DAILY_RECAP
# also open bonus boosters (quest rewards), once the free stock is empty
USE_BONUS=$USE_BONUS
# claim the daily login reward, as the site does from every page it loads
DAILY_LOGIN=$DAILY_LOGIN
# play the daily "Which is rarer?" mini-game (asks anilist.co how popular each character is)
PLAY_RARER=$PLAY_RARER
CURL_BIN=$CURL_BIN
EOF
}

ensure_profile() {
