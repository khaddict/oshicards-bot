BROWSER=()
LOCALE="en"
load_browser() {
  local ua="" al="" ch="" plat="" mob="" loc=""
  if [[ -f $DEVICE ]]; then
    IFS=$'\x1f' read -r ua al ch plat mob loc < <(jq -r '.browser // {} |
      [.ua // "", .accept_language // "", .sec_ch_ua // "", .platform // "", (.mobile // false | tostring), .locale // ""] | join("\u001f")' "$DEVICE")
  fi
  if [[ -z $ua ]]; then
    ua="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/157.0.0.0 Safari/537.36"
    al="en-US,en;q=0.9"
    ch='"Not-A.Brand";v="99", "Chromium";v="157", "Google Chrome";v="157"'
    plat="Windows"; mob="false"
  fi
  LOCALE=${loc:-en}
  BROWSER=(-A "$ua" -H "Accept-Language: $al")
  if [[ -n $ch ]]; then
    BROWSER+=(-H "sec-ch-ua: $ch" -H "sec-ch-ua-mobile: $([[ $mob == true ]] && echo '?1' || echo '?0')"
      -H "sec-ch-ua-platform: \"$plat\"")
  fi
}

has_browser() { [[ -f $DEVICE ]] && jq -e '.browser.ua' "$DEVICE" >/dev/null 2>&1; }

# $1 = JSON produced by the console snippet
save_browser() {
  local b
  b=$(jq -c --arg locales "$LOCALES" '
    select(type == "object" and (.ua | type == "string") and (.ua | startswith("Mozilla/"))) |
    (.lang // ["en-US", "en"]) as $l |
    {ua,
     sec_ch_ua: (if (.brands | type) == "array" then (.brands | map("\"\(.brand)\";v=\"\(.version)\"") | join(", ")) else null end),
     platform: (.platform // null),
     mobile: (.mobile // false),
     accept_language: ($l[:5] | to_entries | map(if .key == 0 then .value else "\(.value);q=0.\(10 - .key)" end) | join(",")),
     locale: (($l[0] // "en")[:2] as $c | if ($locales | split(" ") | index($c)) then $c else "en" end)}' <<<"$1" 2>/dev/null)
  [[ -z $b ]] && return 1
  ensure_device
  jq -c --argjson b "$b" '.browser = $b' "$DEVICE" >"$DEVICE.tmp" && mv "$DEVICE.tmp" "$DEVICE"
  load_browser
}

save_site_cookies() {
  local name val
  for name in NEXT_LOCALE oshi_dev oc_visit; do
    val=$(grep -i "^set-cookie: $name=" "$1" | tail -1 | tr -d '\r' | sed -E 's/^[^=]+=([^;]*).*/\1/')
    [[ -z $val ]] && continue
    jq -c --arg n "$name" --arg v "$val" '.cookies[$n]=$v' "$DEVICE" >"$DEVICE.tmp" && mv "$DEVICE.tmp" "$DEVICE"
  done
}

cookie_header() {
  local val i=0 out
  ensure_device
  out=$(jq -r '.cookies | to_entries | map("\(.key)=\(.value); ") | add // ""' "$DEVICE")
  val="base64-$(jq -c . "$SESSION" | tr -d '\n' | base64 -w0 | tr '/+' '_-' | tr -d '=')"
  if (( ${#val} <= 3180 )); then
    echo "Cookie: $out$COOKIE_NAME=$val"; return
  fi
  while [[ -n $val ]]; do
    out+="$COOKIE_NAME.$i=${val:0:3180}; "
    val=${val:3180}
    i=$((i + 1))
  done
  echo "Cookie: ${out%; }"
}

PAGE_CODE=000
PAGE_HTML=""
# loads a page of the site like a browser tab would; $1 = path, default the pack page
visit_page() {
  local hdr path=${1:-/$LOCALE/open/$SLUG}
  hdr=$(mktemp)
  PAGE_HTML=$(mktemp)
  PAGE_CODE=$("$CURL_BIN" -sS -m 30 "${BROWSER[@]}" -H "$(cookie_header)" \
    -H 'Accept: text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,*/*;q=0.8' \
    -H 'sec-fetch-dest: document' -H 'sec-fetch-mode: navigate' -H 'sec-fetch-site: none' \
    -H 'upgrade-insecure-requests: 1' --compressed \
    -D "$hdr" -o "$PAGE_HTML" -w '%{http_code}' "$SITE$path" 2>/dev/null) || PAGE_CODE=000
  [[ $PAGE_CODE == 200 ]] && save_site_cookies "$hdr"
  rm -f "$hdr"
}

# ---------- server actions ----------

# The site's buttons call "server actions" whose ids change with every site update.
# Prints the id of action $1, read from the scripts of the page saved in $2.
find_action() {
  local name=$1 html=$2 cached id chunk url found
  cached=$(state_get "ACT_$name" "")
  id=${cached%%|*}; chunk=${cached#*|}
  if [[ -n $id && $cached == *"|"* ]] && grep -qF "$chunk" "$html"; then
    echo "$id"; return 0
  fi
  for url in $(grep -oE '/_next/static/[^"\\ ?]+\.js(\?dpl=[A-Za-z0-9_.-]+)?' "$html" | sort -u); do
    found=$("$CURL_BIN" -sS -m 30 "${BROWSER[@]}" -H 'Accept: */*' -H "Referer: $SITE/" \
      -H 'sec-fetch-dest: script' -H 'sec-fetch-mode: no-cors' -H 'sec-fetch-site: same-origin' --compressed \
      "$SITE$url" 2>/dev/null |
      grep -oE '"[0-9a-f]{42}",[A-Za-z_$]+\.callServer,void 0,[A-Za-z_$]+\.findSourceMapURL,"'"$name"'"' | head -1)
    if [[ -n $found ]]; then
      state_set "ACT_$name" "${found:1:42}|${url%%\?*}"
      echo "${found:1:42}"; return 0
    fi
  done
  return 1
}

# calls action $1 from page path $2 with JSON arguments $3; $4 = that page's saved html
ACT_STATUS=000
ACT_BODY=""
call_action() {
  local id out
  ACT_STATUS=000; ACT_BODY=""
  id=$(find_action "$1" "$4") || { ACT_STATUS=404; return 1; }
  out=$("$CURL_BIN" -sS -m 30 "${BROWSER[@]}" -H "$(cookie_header)" -H 'Accept: text/x-component' \
    -H 'Content-Type: text/plain;charset=UTF-8' -H "Next-Action: $id" \
    -H "Origin: $SITE" -H "Referer: $SITE$2" \
    -H 'sec-fetch-dest: empty' -H 'sec-fetch-mode: cors' -H 'sec-fetch-site: same-origin' --compressed \
    -d "$3" -w $'\n%{http_code}' "$SITE$2" 2>/dev/null) || return 1
  ACT_STATUS=${out##*$'\n'}
  if [[ $ACT_STATUS != 200 ]]; then
    state_set "ACT_$1" ""
    return 1
  fi
  ACT_BODY=$(grep -m1 '^1:' <<<"$out" | cut -c3-)
  [[ -n $ACT_BODY ]]
}

# The site's pages claim the daily login reward by themselves when they load.
daily_login() {
  local html=$1 bonus
  (( DAILY_LOGIN )) || return 0
  if ! call_action claimDailyLogin "/$LOCALE/open/$SLUG" '[]' "$html"; then
    case $ACT_STATUS in
      000) ;;
      404) warn "daily login: not found in the site's code, skipped" ;;
      *) warn "daily login: the site answered HTTP $ACT_STATUS, skipped" ;;
    esac
    return 0
  fi
  jq -e '.day' >/dev/null 2>&1 <<<"$ACT_BODY" || return 0
  state_set LOGIN_DAY "$(jq -r '"\(.day)/\(.cycle // 7)"' <<<"$ACT_BODY")"
  if [[ $(jq -r '.claimed' <<<"$ACT_BODY") == true ]]; then
    ok "daily login claimed: day $(state_get LOGIN_DAY "?")"
  fi
  if [[ $(jq -r '.claimed or (.state.login_claimed_today // false)' <<<"$ACT_BODY") == true ]]; then
    state_set LOGIN_DATE "$(date -d "@$(now)" +%F)"
  fi
  bonus=$(jq -r '.state.bonus_boosters // empty' <<<"$ACT_BODY")
  [[ $bonus =~ ^[0-9]+$ ]] && state_set BONUS "$bonus"
  return 0
}

LAST_PING=0
presence_ping() {
  (( $(now) - LAST_PING < 60 )) && return 0
  LAST_PING=$(now)
  http_post "$SUPABASE/rest/v1/rpc/presence_ping" \
    "$(jq -c '{p_key:.presence_key}' "$DEVICE")" "${BROWSER[@]}" \
    -H "apikey: $APIKEY" -H "Authorization: Bearer $(jq -r .access_token "$SESSION")" \
    -H 'content-profile: public' -H 'x-client-info: supabase-ssr/0.12.7 createBrowserClient' \
    -H "Origin: $SITE" -H "Referer: $SITE/"
}

# sleeps while keeping presence alive, like an open tab
idle() {
  local left=$1 step
  while (( left > 0 )); do
    step=$(( left < 20 ? left : 20 ))
    sleep "$step"
    left=$((left - step))
    presence_ping
  done
}

# ---------- discord ----------

discord_send() {
  [[ -z $WEBHOOK ]] && return 0
  http_post "$WEBHOOK" "$1"
  [[ $HTTP_STATUS == 2* ]] || warn "Discord webhook failed ($HTTP_STATUS)"
}

discord_text() {
  discord_send "$(jq -nc --arg c "$1" '{username:"oshibot", content:$c}')"
}

loot_payload() {
  jq -c --argjson rar "$NOTIFY_RARITIES" '
    [.result.boosters[].cards[] | select(.rarity as $r | $rar | index($r))]
    | if length == 0 then empty else
      {username: "Oshi", embeds: (.[:10] | map({
        title: ((.rarity | ascii_upcase) + ": " + .name),
        description: (.series_title // ""),
        color: (if .rarity == "mythic" then 15680580 else 16096779 end),
        thumbnail: {url: .image_url},
        fields: ([
          {name: "Serial", value: "#\(.serial // "?")", inline: true},
          {name: "New", value: (if .is_new then "yes" else "no" end), inline: true}
        ] + (if .variant then [{name: "Variant", value: (.variant | tostring), inline: true}] else [] end))
      }))}
    end' <<<"$1"
}

# ---------- safety stop ----------

halt() {
  echo "$1" >"$HALT"
  err "stopped: $1"
  err "check your account in a browser, then run: ${B}oshibot resume${R}"
  discord_text "oshibot stopped itself: $1. Check your account in a browser, then run \`oshibot resume\`."
}

# unexpected answer: tell a dead session (2) apart from a refusal by the site (3)
stop_or_expired() {
  refresh_session "$(jq -r .refresh_token "$SESSION")"
  (( $? == 2 )) && return 2
  halt "$1"
  return 3
}

# ---------- stats ----------

declare -A S_PACKS=() S_RARE=() S_EPIC=() S_LEG=() S_MYTH=()
load_stats() {
  S_PACKS=(); S_RARE=(); S_EPIC=(); S_LEG=(); S_MYTH=()
  [[ -f $HISTORY ]] || return 0
  local ts rar day r
  while IFS=$'\t' read -r ts rar; do
    [[ $ts =~ ^[0-9]+$ ]] || continue
    printf -v day '%(%F)T' "$ts"
    S_PACKS[$day]=$(( ${S_PACKS[$day]:-0} + 1 ))
    for r in ${rar//,/ }; do
      case $r in
        rare) S_RARE[$day]=$(( ${S_RARE[$day]:-0} + 1 )) ;;
        epic) S_EPIC[$day]=$(( ${S_EPIC[$day]:-0} + 1 )) ;;
        legendary) S_LEG[$day]=$(( ${S_LEG[$day]:-0} + 1 )) ;;
        mythic) S_MYTH[$day]=$(( ${S_MYTH[$day]:-0} + 1 )) ;;
      esac
    done
  done <"$HISTORY"
}

recap_line() {
  local d=$1
  echo "${S_PACKS[$d]:-0} packs, ${S_RARE[$d]:-0} rare, ${S_EPIC[$d]:-0} epic, ${S_LEG[$d]:-0} legendary, ${S_MYTH[$d]:-0} mythic"
}

# ---------- opening ----------

print_cards() {
  jq -r '.result.boosters[].cards[] | "\(.rarity)\t\(.name)\t\((.series_title // "")[:50])\t\(if .is_new then "NEW" else "" end)"' <<<"$1" |
  while IFS=$'\t' read -r rar name series new; do
    local c=$DIM
    case $rar in
      *rare) c=$CYA ;;
      *epic) c=$YEL ;;
      *legendary | *mythic) c=$B$RED ;;
    esac
    printf '           %s%-10s%s %s %s(%s)%s %s\n' "$c" "$rar" "$R" "$name" "$DIM" "$series" "$R" "${new:+${GRN}$new${R}}"
  done
}

# one play session: loads the page, then opens up to $1 packs.
# 0 = ok, 2 = dead session, 3 = safety stop
play_session() {
  local want=$1 opened=0 i key payload body rc pause next_free fails free bonus full=0 ret=0
  (( want >= $(max_packs) )) && full=1
  bonus=$(state_get BONUS 0)
  (( USE_BONUS )) || bonus=0
  if [[ -f $HALT ]]; then
    err "stopped earlier: $(<"$HALT") (run: ${B}oshibot resume${R})"; return 3
  fi
  next_free=$(state_get NEXT_FREE 0)
  if (( $(now) < next_free && bonus <= 0 )); then
    log "no free booster before $(date -d "@$next_free" +%H:%M)"; return 0
  fi
  load_browser
  ensure_session; rc=$?
  (( rc == 2 )) && return 2
  (( rc == 1 )) && { warn "network unavailable, session postponed"; return 0; }

  visit_page
  if [[ $PAGE_CODE == 200 ]]; then
    idle "$(rand 1 3)"
    daily_login "$PAGE_HTML"
  fi
  rm -f "$PAGE_HTML"
  case $PAGE_CODE in
    200) state_set PAGE_FAILS 0 ;;
    403 | 429) halt "the pack page answered HTTP $PAGE_CODE, the site may be blocking this tool"; return 3 ;;
    000 | 5*) warn "pack page unreachable ($PAGE_CODE), session postponed"; return 0 ;;
    *)
      # redirected to the login page or similar: renew the session, give up after 3 tries
      fails=$(( $(state_get PAGE_FAILS 0) + 1 ))
      state_set PAGE_FAILS "$fails"
      refresh_session "$(jq -r .refresh_token "$SESSION")"
      (( $? == 2 )) && return 2
      if (( fails >= 3 )); then
        halt "the pack page keeps answering HTTP $PAGE_CODE"; return 3
      fi
      warn "pack page answered HTTP $PAGE_CODE, session renewed and postponed"; return 0 ;;
  esac
  LAST_PING=0
  presence_ping
  idle "$(rand 4 12)"

  for ((i = 1; i <= want; i++)); do
    ensure_session; rc=$?
    (( rc == 2 )) && return 2
    (( rc == 1 )) && { warn "network unavailable"; break; }

    http_post "$SITE/api/open" \
      "$(jq -nc --arg s "$SLUG" --arg id "$(cat /proc/sys/kernel/random/uuid)" \
        '{slug:$s, quantity:1, maxGems:0, requestId:$id}')" \
      "${BROWSER[@]}" -H "$(cookie_header)" -H 'Accept: */*' \
      -H "Origin: $SITE" -H "Referer: $SITE/$LOCALE/open/$SLUG" \
      -H 'sec-fetch-dest: empty' -H 'sec-fetch-mode: cors' -H 'sec-fetch-site: same-origin'

    case $HTTP_STATUS in
      200) ;;
      000 | 5*) warn "server unavailable ($HTTP_STATUS)"; break ;;
      403 | 429) halt "opening a pack answered HTTP $HTTP_STATUS, the site may be blocking this tool"; ret=3; break ;;
      *) stop_or_expired "opening a pack answered HTTP $HTTP_STATUS"; ret=$?; break ;;
    esac
    key=$(jq -r '.errorKey // empty' <<<"$HTTP_BODY" 2>/dev/null)
    if [[ $key == stockChanged ]]; then
      log "no free booster available"; break
    elif [[ -n $key ]]; then
      stop_or_expired "opening a pack was refused with error \"$key\""; ret=$?; break
    elif ! jq -e .result.boosters >/dev/null 2>&1 <<<"$HTTP_BODY"; then
      stop_or_expired "opening a pack returned an unknown response"; ret=$?; break
    fi

    body=$HTTP_BODY
    opened=$((opened + 1))
    (( opened == 1 )) && learn_stock "$body"
    log "${B}pack $opened${R}$(jq -r '(if (.result.paid.bonus // 0) > 0 then " (bonus)" else "" end) + (if any(.result.boosters[]; .golden) then " (golden)" else "" end)' <<<"$body")"
    print_cards "$body"
    printf '%s\t%s\n' "$(now)" "$(jq -r '[.result.boosters[].cards[].rarity] | join(",")' <<<"$body")" >>"$HISTORY"
    jq -r '.result.boosters[].cards[] | [.card_id, .rarity, .name] | @tsv' <<<"$body" 2>/dev/null | learn_rarities
    payload=$(loot_payload "$body")
    [[ -n $payload ]] && discord_send "$payload"

    if (( $(jq -r '.result.paid.gems // 0' <<<"$body") > 0 )); then
      halt "a pack was paid with gems instead of a free booster"; ret=3; break
    fi
    free=$(jq -r '.result.state.free_boosters // 0' <<<"$body")
    bonus=$(jq -r '.result.state.bonus_boosters // 0' <<<"$body")
    state_set BONUS "$bonus"
    if (( free <= 0 )); then
      next_free=$(date -d "$(jq -r '.result.state.next_free_at // empty' <<<"$body")" +%s 2>/dev/null) || next_free=0
      state_set NEXT_FREE "$next_free"
    else
      state_set NEXT_FREE 0
    fi
    (( USE_BONUS )) || bonus=0
    (( free + bonus <= 0 )) && break
    # a full session empties everything that is left, bonus boosters included
    (( full )) && want=$(( i + free + bonus ))
    if (( i < want )); then
      pause=$(rand $PACK_PAUSE_MIN $PACK_PAUSE_MAX)
      (( $(rand 1 100) <= LONG_PAUSE_CHANCE )) && pause=$((pause + $(rand $LONG_PAUSE_MIN $LONG_PAUSE_MAX)))
      idle "$pause"
    fi
  done
  state_set LAST_SESSION "$(now)"
  (( ret == 2 )) && err "the session is no longer valid"
  ok "$opened pack(s) opened"
  return $ret
}

locked() {
  exec 9>"$LOCK"
  flock -w 600 9 || die "another session is already running"
  "$@"; local rc=$?
  flock -u 9
  return $rc
}

locked_session() { locked play_session "$1"; }

# ---------- mini-game: which is rarer? ----------

paris_day() { TZ=Europe/Paris date -d "@$(now)" +%F; }

# AniList character id, read from a card's image address
card_id_of() {
  local base=${1##*/}
  [[ $base =~ ^[a-z]?([0-9]+) ]] && echo "${BASH_REMATCH[1]}"
}

# prints the AniList favourites of characters $1 and $2 ("" when unknown). Rarity follows popularity.
anilist_favs() {
  local out
  out=$("$CURL_BIN" -sS -m 20 -X POST https://graphql.anilist.co \
    -H 'Content-Type: application/json' -H 'Accept: application/json' \
    -d "$(jq -nc --argjson a "$1" --argjson b "$2" \
      '{query: "query($ids:[Int]){Page(perPage:5){characters(id_in:$ids){id favourites}}}", variables: {ids: [$a, $b]}}')" \
    2>/dev/null) || return 1
  jq -r --argjson a "$1" --argjson b "$2" '
    (.data.Page.characters // []) as $c
    | "\(first($c[] | select(.id == $a) | .favourites) // "") \(first($c[] | select(.id == $b) | .favourites) // "")"' <<<"$out" 2>/dev/null
}

# The true rarity of every card seen (opened packs, answers revealed by the game) is kept
# locally: popularity alone misses the few classics that the site always makes Mythic.
rarity_rank() {
  case $1 in
    common) echo 1 ;; uncommon) echo 2 ;; rare) echo 3 ;; epic) echo 4 ;; legendary) echo 5 ;; mythic) echo 6 ;;
    *) echo 0 ;;
  esac
}

known_rarity() {
  [[ -f $RARITIES ]] || return 0
  awk -F'\t' -v id="$1" '$1 == id { r = $2 } END { print r }' "$RARITIES"
}

# reads "id<TAB>rarity<TAB>name" lines on stdin
learn_rarities() {
  local id rar name
  while IFS=$'\t' read -r id rar name; do
    [[ $id =~ ^[0-9]+$ ]] && (( $(rarity_rank "$rar") > 0 )) || continue
    [[ $(known_rarity "$id") == "$rar" ]] || printf '%s\t%s\t%s\n' "$id" "$rar" "$name" >>"$RARITIES"
  done
}

# plays today's rewarded game ($1 = free: a replay with no reward). 0 = done or skipped, 2 = dead session, 3 = safety stop
play_rarer() {
  local path="/$LOCALE/games/rarer" html esc played play pid rc round ida idb fa fb ra rb pick how last free=${1:-}
  if [[ -f $HALT ]]; then
    err "stopped earlier: $(<"$HALT") (run: ${B}oshibot resume${R})"; return 3
  fi
  load_browser
  ensure_session; rc=$?
  (( rc == 2 )) && return 2
  (( rc == 1 )) && { warn "network unavailable, game postponed"; return 0; }

  visit_page "$path"
  html=$PAGE_HTML
  case $PAGE_CODE in
    200) ;;
    403 | 429) rm -f "$html"; halt "the game page answered HTTP $PAGE_CODE, the site may be blocking this tool"; return 3 ;;
    *) rm -f "$html"; warn "game page unreachable ($PAGE_CODE), game postponed"; return 0 ;;
  esac
  LAST_PING=0
  presence_ping

  # the page carries the state of today's game: finished, in progress, or not started
  esc=$(grep -oP '\\"game\\":\\"rarer\\",\\"gems\\":\d+,\\"play\\":\K.*?(?=,\\"played\\":(true|false))' "$html" | head -1)
  played=$(grep -oP '\\"game\\":\\"rarer\\",\\"gems\\":\d+,\\"play\\":.*?,\\"played\\":\K(true|false)' "$html" | head -1)
  play=""
  [[ -n $esc && $esc != null ]] && play=$(printf '"%s"' "$esc" | jq -r . 2>/dev/null | jq -c . 2>/dev/null)
  if [[ -z $free && $played == true && ( -z $play || $(jq -r '.finished' <<<"$play") == true ) ]]; then
    state_set RARER_DAY "$(paris_day)"
    log "which is rarer: already played today"
    rm -f "$html"; return 0
  fi
  if [[ -z $play || $(jq -r '.finished' <<<"$play") == true ]]; then
    idle "$(rand 2 5)"
    if ! call_action gameStartAction "$path" '["rarer"]' "$html"; then
      warn "which is rarer: could not start a game (HTTP $ACT_STATUS)"; rm -f "$html"; return 0
    fi
    play=$(jq -c '.play // empty' <<<"$ACT_BODY" 2>/dev/null)
    if [[ -z $play ]]; then
      warn "which is rarer: $(jq -r '.error // "no game returned"' <<<"$ACT_BODY" 2>/dev/null)"; rm -f "$html"; return 0
    fi
  fi
  if [[ -z $free && $(jq -r '.rewarded' <<<"$play") != true ]]; then
    state_set RARER_DAY "$(paris_day)"
    log "which is rarer: today's rewarded game is already used"
    rm -f "$html"; return 0
  fi

  pid=$(jq -r '.id' <<<"$play")
  for ((round = 1; round <= 30; round++)); do
    [[ $(jq -r '.finished' <<<"$play") == true ]] && break
    ida=$(card_id_of "$(jq -r '.cards[0].image_url // ""' <<<"$play")")
    idb=$(card_id_of "$(jq -r '.cards[1].image_url // ""' <<<"$play")")
    ra=$(rarity_rank "$(known_rarity "${ida:-0}")")
    rb=$(rarity_rank "$(known_rarity "${idb:-0}")")
    fa=""; fb=""
    if (( ra > 0 && rb > 0 && ra != rb )); then
      how="known rarities"
      pick=0; (( rb > ra )) && pick=1
    elif (( ra == 6 || rb == 6 )); then
      how="known mythic"
      pick=0; (( rb == 6 )) && pick=1
    else
      [[ -n $ida && -n $idb ]] && read -r fa fb < <(anilist_favs "$ida" "$idb")
      if [[ ! $fa =~ ^[0-9]+$ || ! $fb =~ ^[0-9]+$ ]]; then
        warn "which is rarer: popularity unknown for this pair, game left for later"
        rm -f "$html"; return 0
      fi
      how="$fa vs $fb favourites"
      pick=0; (( fb > fa )) && pick=1
    fi
    idle "$(rand 1 5)"
    if ! call_action gameAnswerAction "$path" "$(jq -nc --argjson id "$pid" --arg p "$pick" '[$id, $p]')" "$html"; then
      warn "which is rarer: answer refused (HTTP $ACT_STATUS), game left for later"; rm -f "$html"; return 0
    fi
    last=$(jq -c '.play // empty' <<<"$ACT_BODY" 2>/dev/null)
    if [[ -z $last ]]; then
      warn "which is rarer: $(jq -r '.error // "no answer returned"' <<<"$ACT_BODY" 2>/dev/null)"; rm -f "$html"; return 0
    fi
    log "which is rarer, round $round: $(jq -r '.cards | map(.name) | join(" vs ")' <<<"$play"), picked $(jq -r --argjson i "$pick" '.cards[$i].name' <<<"$play") ($how) $([[ $(jq -r '.last.correct' <<<"$last") == true ]] && echo "${GRN}correct${R}" || echo "${RED}wrong${R}")"
    play=$last
    jq -r '.last.cards // [] | .[] | select(.rarity != null)
      | [(.card_id // (.image_url // "" | split("/") | last | capture("^[a-z]?(?<n>[0-9]+)").n)), .rarity, .name] | @tsv' <<<"$play" 2>/dev/null | learn_rarities
  done
  rm -f "$html"
  if [[ $(jq -r '.finished' <<<"$play") == true ]]; then
    if [[ -z $free ]]; then
      state_set RARER_DAY "$(paris_day)"
      state_set RARER_RESULT "$(jq -r '"\(.score // 0)/\(.rounds // 10), +\(.gems // 0) gems"' <<<"$play")"
      discord_text "\"Which is rarer?\" played today: $(jq -r '"score \(.score // 0)/\(.rounds // 10), +\(.gems // 0) gems"' <<<"$play")."
    fi
    ok "which is rarer: $(jq -r '"\(.score // 0)/\(.rounds // 10), +\(.gems // 0) gems"' <<<"$play")"
  fi
  return 0
}

# true when today's game is still to play and its random time of day has come
rarer_due() {
  (( PLAY_RARER )) || return 1
  local today
  today=$(paris_day)
  [[ $(state_get RARER_DAY "") == "$today" ]] && return 1
  if [[ $(state_get GAME_DAY "") != "$today" ]]; then
    state_set GAME_DAY "$today"
    state_set GAME_AT $(( $(TZ=Europe/Paris date -d "$today 00:00" +%s) + $(rand 32400 72000) ))
  fi
  (( $(now) >= $(state_get GAME_AT 0) ))
}

# ---------- schedule ----------

BED=0
WAKE=0
DAY_FACTOR=10

is_weekend_night() { [[ $(date -d "@$1" +%u) -ge 6 ]]; }

# $1 = midnight the night is attached to
draw_night() {
  local shift=0
  is_weekend_night "$1" && shift=$WEEKEND_SHIFT
  BED=$(( $1 + (BED_BASE + shift) * 60 + $(rand 0 $((NIGHT_JITTER * 120))) - NIGHT_JITTER * 60 ))
  WAKE=$(( BED + SLEEP_MIN * 60 + $(rand 0 2400) - 1200 ))
  # no sleep: the night is empty and only marks the change of day
  (( SLEEP_MIN > 0 )) || WAKE=$BED
}

# upcoming night, or the current one when started before wake-up
plan_night() {
  local t=$(now) base prev=$WAKE i
  base=$(date -d "$(date -d "@$t" +%F) 00:00" +%s)
  draw_night "$base"
  # skip nights that are already over, or the one we just woke up from
  for i in 1 2 3; do
    (( WAKE <= t )) || (( prev > 0 && BED < prev + 14400 )) || break
    base=$(date -d "$(date -d "@$base" +%F) tomorrow" +%s)
    draw_night "$base"
  done
  DAY_FACTOR=10
  (( $(rand 1 100) <= LIGHT_DAY_CHANCE )) && DAY_FACTOR=$(rand 25 40)
  state_set BED "$BED"; state_set WAKE "$WAKE"; state_set LIGHT "$(( DAY_FACTOR > 10 ))"
}

quiet_adjust() {
  local target=$1 qs
  if (( QUIET_LEN > 0 )) && (( $(date -d "@$target" +%u) <= 5 )); then
    qs=$(( $(date -d "$(date -d "@$target" +%F) 00:00" +%s) + QUIET_START * 60 ))
    if (( target >= qs && target < qs + QUIET_LEN * 60 )); then
      target=$(( qs + QUIET_LEN * 60 + $(rand 0 1500) ))
    fi
  fi
  echo "$target"
}

# $1 = wanted delay in seconds, prints the epoch of the next session
next_session_at() {
  local t=$(now) target
  target=$((t + $1))
  if (( target >= BED && target < WAKE )); then
    # one last session at bedtime if worth it, otherwise at wake-up
    if (( BED > t + 2400 )); then target=$BED; else target=$WAKE; fi
  else
    target=$(quiet_adjust "$target")
  fi
  echo "$target"
}

pause_until() {
  local p=0
  [[ -f $PAUSE ]] && p=$(<"$PAUSE")
  echo "${p:-0}"
}

send_recap() {
  (( DAILY_RECAP )) && [[ -n $WEBHOOK ]] || return 0
  local d
  d=$(date -d "@$(( $(now) - 86400 ))" +%F)
  load_stats
  (( ${S_PACKS[$d]:-0} > 0 )) && discord_text "Yesterday: $(recap_line "$d")."
  return 0
}

cmd_run() {
  local gap target first=1 last want pu fill rc
  ensure_profile
  ensure_device
  load_browser
  has_browser || warn "no browser identity saved, using a generic one (run: oshibot browser)"
  [[ -f $HALT ]] && { err "stopped earlier: $(<"$HALT") (run: ${B}oshibot resume${R})"; exit 3; }
  plan_night
  log "loop started with the ${B}$PRESET${R} preset"
  while true; do
    if (( $(now) >= WAKE )); then
      plan_night
      send_recap
    fi
    pu=$(pause_until)
    if (( pu > $(now) )); then
      log "paused until $(date -d "@$pu" '+%a %d %b %H:%M')"
      state_set NEXT "$pu"
      gap=$(( pu - $(now) ))
      sleep $(( gap < 21600 ? gap : 21600 ))
      first=1
      continue
    fi
    if (( first )); then
      first=0
      gap=$(rand 60 300)
      last=$(state_get LAST_SESSION 0)
      (( last + GAP_MIN * 60 - $(now) > gap )) && gap=$(( last + GAP_MIN * 60 - $(now) ))
    else
      gap=$(( $(rand $GAP_MIN $GAP_MAX) * 6 * DAY_FACTOR + $(rand 0 59) ))
      # the top presets come back before the stock is full, whatever its size
      fill=$(( $(max_packs) * $(regen_minutes) * 60 ))
      if [[ $PRESET == grinder || $PRESET == nonstop ]] && (( DAY_FACTOR == 10 && gap > fill )); then
        gap=$(( fill - $(rand 0 420) ))
      fi
      if (( $(rand 1 100) <= SKIP_CHANCE )); then
        gap=$(( gap + $(rand $SKIP_EXTRA_MIN $SKIP_EXTRA_MAX) * 60 ))
      fi
    fi
    target=$(next_session_at "$gap")
    state_set NEXT "$target"
    log "next session at $(date -d "@$target" '+%a %H:%M') (in $(( (target - $(now)) / 60 )) min)$( ((SLEEP_MIN > 0)) && echo ", night from $(date -d "@$BED" +%H:%M) to $(date -d "@$WAKE" +%H:%M)")$( ((DAY_FACTOR > 10)) && echo ', light day')"
    gap=$(( target - $(now) ))
    sleep $(( gap > 0 ? gap : 0 ))
    (( $(pause_until) > $(now) )) && continue

    want=$(max_packs)
    (( want > 4 && $(rand 1 100) <= PARTIAL_CHANCE )) && want=$(rand 3 $(( want * 3 / 4 )))
    locked_session "$want"; rc=$?
    if (( rc == 0 )) && rarer_due; then
      sleep "$(rand 8 45)"
      locked play_rarer; rc=$?
    fi
    case $rc in
      2)
        discord_text "oshibot lost its oshicards session: $(session_dead_reason)"
        exit 2 ;;
      3) exit 3 ;;
    esac
  done
}

# ---------- commands ----------

restart_service() {
  systemctl is-enabled -q "$SERVICE" 2>/dev/null || return 0
  # only the copy the service actually runs may restart it
  grep -qF "ExecStart=$DIR/oshibot run" "$UNIT" 2>/dev/null || return 0
  if (( EUID == 0 )); then
    systemctl restart "$SERVICE" && ok "service restarted"
  else
    warn "restart the service to apply: ${B}sudo systemctl restart $SERVICE${R}"
  fi
}

# when run with sudo, hand the data files back to the owner of the directory
fix_owner() {
  (( EUID == 0 )) || return 0
  chown -f "$(stat -c %U:%G "$DIR")" "$SESSION" "$DEVICE" "$PROFILE" "$CONFIG" "$STATE" "$HISTORY" "$PAUSE" "$HALT" "$LOCK" 2>/dev/null
  return 0
}

read_paste() {
  local input=${1:-}
  if [[ -n $input && -f $input ]]; then
    input=$(<"$input")
  elif [[ -z $input && ! -t 0 ]]; then
    input=$(cat)
  elif [[ -z $input ]]; then
    read -r -e -p "Paste > " input
    echo >&2
  fi
  echo "$input"
}

cmd_cookie() {
  local input=${1:-} token cookie login
  if [[ -z $input && -t 0 ]]; then
    cat <<EOF
${B}How to connect your oshicards account${R}

  1. Open ${CYA}$SITE${R} in a ${B}private browsing window${R} of your usual browser and log in.
  2. Press F12, open the ${B}Console${R} tab and paste this line:

       ${GRN}$SNIPPET${R}

     (if the browser blocks pasting, type this first: allow pasting)
  3. Paste the result below and press Enter.
  4. ${B}Close the private window right away, without logging out.${R}

  ${DIM}The line copies your session cookie and your browser's identity (user agent,
  language) so the tool presents itself like your own browser.
  Why a private window, closed at once: the login must belong to oshibot alone.
  If a browser keeps using the same login, the two log each other out within hours.
  Your regular browser has its own login and is not affected.${R}

EOF
  fi
  input=$(read_paste "$input")
  cookie=$input
  if jq -e 'type == "object"' >/dev/null 2>&1 <<<"$input"; then
    cookie=$(jq -r '.cookie // ""' <<<"$input")
    save_browser "$input" && ok "browser identity saved" || warn "could not read the browser identity"
  fi
  load_browser
  token=$(extract_refresh_token "$cookie") || true
  [[ -z $token ]] && die "no $COOKIE_NAME cookie found in what you pasted"
  refresh_session "$token" || die "could not create the session (cookie expired or already used?)"
  ok "session saved for ${B}$(jq -r '.user.email // .user.id' "$SESSION")${R}"
  login=$(session_login_time)
  if (( login > 0 && $(now) - login > 1200 )); then
    warn "this login is $(( ($(now) - login) / 60 )) min old, so it is probably shared with an open browser."
    warn "They will log each other out within hours. Use a fresh private window and close it right after."
  fi
  has_browser || warn "no browser identity saved, a generic one will be used (run: oshibot browser)"
  restart_service
}

cmd_browser() {
  local input=${1:-}
  if [[ -z $input && -t 0 ]]; then
    cat <<EOF
${B}Save your browser's identity${R}

  In the browser you normally play with, press F12, open the ${B}Console${R} tab on any page and paste:

       ${GRN}$SNIPPET${R}

  Then paste the result below. Only the user agent and language are kept.

EOF
  fi
  input=$(read_paste "$input")
  save_browser "$input" || die "this is not the output of the console line"
  ok "browser identity saved: $(jq -r .browser.ua "$DEVICE")"
  restart_service
}

cmd_profile() {
  local preset=${1:-}
  if [[ -z $preset ]]; then
    ensure_profile
    show_profile
    echo
    echo "Redraw with: oshibot profile <chill|regular|grinder|nonstop>"
    return
  fi
  gen_profile "$preset"
  ok "new ${B}$preset${R} profile drawn"
  show_profile
  restart_service
}

cmd_webhook() {
  local url=${1:-}
  case $url in
    "")
      if [[ -n $WEBHOOK ]]; then echo "Webhook: ${WEBHOOK:0:60}..."; else echo "No webhook configured."; fi
      cat <<EOF

Usage: oshibot webhook <url>     save the webhook
       oshibot webhook test      send a test message
       oshibot webhook off       remove it

To create the URL: Discord > channel > Edit > Integrations > Webhooks > New Webhook > Copy Webhook URL.
EOF
      ;;
    test)
      [[ -z $WEBHOOK ]] && die "no webhook configured"
      discord_send "$(loot_payload '{"result":{"boosters":[{"cards":[{"name":"Test card","rarity":"legendary","serial":1,"series_title":"oshibot webhook test","image_url":"https://s4.anilist.co/file/anilistcdn/character/large/3437.jpg","is_new":true,"variant":null}]}]}}')"
      [[ $HTTP_STATUS == 2* ]] && ok "test message sent"
      ;;
    off)
      rm -f "$CONFIG"; ok "webhook removed"
      ;;
    https://discord.com/api/webhooks/* | https://discordapp.com/api/webhooks/* | https://*.discord.com/api/webhooks/*)
      (umask 077; printf 'WEBHOOK=%q\n' "$url" >"$CONFIG")
      WEBHOOK=$url
      ok "webhook saved, try it with: ${B}oshibot webhook test${R}"
      ;;
    *) die "invalid Discord webhook URL" ;;
  esac
}

cmd_open() {
  local max n
  max=$(max_packs)
  n=${1:-$max}
  (( USE_BONUS )) && max=$(( max + $(state_get BONUS 0) ))
  [[ $n =~ ^[0-9]+$ ]] && (( n >= 1 && n <= max )) || die "pack count must be between 1 and $max"
  ensure_profile
  locked_session "$n"
}

cmd_pause() {
  local d=${1:-} secs
  [[ $d =~ ^([0-9]+)([dhm])$ ]] || die "usage: oshibot pause <duration>, for example 3d, 12h or 45m"
  case ${BASH_REMATCH[2]} in
    d) secs=$(( BASH_REMATCH[1] * 86400 )) ;;
    h) secs=$(( BASH_REMATCH[1] * 3600 )) ;;
    m) secs=$(( BASH_REMATCH[1] * 60 )) ;;
  esac
  echo $(( $(now) + secs )) >"$PAUSE"
  ok "paused until $(date -d "@$(<"$PAUSE")" '+%a %d %b %H:%M') (cancel with: oshibot resume)"
}

cmd_resume() {
  local was=""
  [[ -f $HALT ]] && was="safety stop cleared"
  [[ -f $PAUSE ]] && was="${was:+$was, }pause cancelled"
  rm -f "$HALT" "$PAUSE"
  ok "${was:-nothing to resume}"
  restart_service
}

cmd_stats() {
  local i d total=0
  load_stats
  printf '%s%-12s %6s %6s %6s %10s %7s%s\n' "$B" Day Packs Rare Epic Legendary Mythic "$R"
  for i in 6 5 4 3 2 1 0; do
    d=$(date -d "@$(( $(now) - i * 86400 ))" +%F)
    printf '%-12s %6s %6s %6s %10s %7s\n' "$d" "${S_PACKS[$d]:-0}" "${S_RARE[$d]:-0}" "${S_EPIC[$d]:-0}" "${S_LEG[$d]:-0}" "${S_MYTH[$d]:-0}"
  done
  for d in "${!S_PACKS[@]}"; do total=$(( total + S_PACKS[$d] )); done
  echo
  echo "All time: $total packs over ${#S_PACKS[@]} day(s)"
}

cmd_status() {
  local exp left pu next
  if [[ -f $SESSION ]]; then
    exp=$(jq -r '.expires_at // 0' "$SESSION"); left=$(( exp - $(now) ))
    echo "Session : ${GRN}$(jq -r '.user.email // .user.id' "$SESSION")${R} (token $( ((left > 0)) && echo "valid for $((left / 60)) more min" || echo "due for renewal on next run"), renewed automatically)"
  else
    echo "Session : ${RED}none${R} (run: oshibot cookie)"
  fi
  echo "Browser : $(has_browser && echo "${GRN}$(jq -r '.browser.ua' "$DEVICE" | grep -oE '(Chrome|Firefox|Version)/[0-9]+' | tail -1)${R}, language $(jq -r .browser.accept_language "$DEVICE")" || echo "${YEL}generic${R} (run: oshibot browser)")"
  echo "Profile : $([[ -n $PRESET ]] && echo "${GRN}$PRESET${R}, sessions every $GAP_MIN to $GAP_MAX min (details: oshibot profile)" || echo "${YEL}not drawn yet${R} (run: oshibot profile <chill|regular|grinder|nonstop>)")"
  echo "Stock   : $([[ -n $(state_get FREE_MAX "") ]] && echo "up to $(max_packs) free boosters, one every $(regen_minutes) min, $(state_get BONUS 0) bonus left (read from your account)" || echo "not known yet, read from the site at the first opening")"
  echo "Login   : $([[ -n $(state_get LOGIN_DAY "") ]] && echo "streak day $(state_get LOGIN_DAY ""), $([[ $(state_get LOGIN_DATE "") == "$(date +%F)" ]] && echo "${GRN}claimed today${R}" || echo "not claimed yet today")" || echo "not known yet")"
  (( PLAY_RARER )) && echo "Game    : which is rarer, $([[ $(state_get RARER_DAY "") == "$(paris_day)" ]] && echo "${GRN}played today${R}${DIM}$(r=$(state_get RARER_RESULT ""); echo "${r:+ ($r)}")${R}" || echo "not played yet today")"
  echo "Webhook : $([[ -n $WEBHOOK ]] && echo "${GRN}configured${R}" || echo "${YEL}not configured${R} (run: oshibot webhook <url>)")"
  if [[ -f $UNIT ]]; then
    echo "Service : $(systemctl is-active "$SERVICE" 2>/dev/null)"
  else
    echo "Service : ${YEL}not installed${R} (run: oshibot install)"
  fi
  [[ -f $HALT ]] && echo "${RED}Stopped${R} : $(<"$HALT") (run: oshibot resume)"
  pu=$(pause_until)
  (( pu > $(now) )) && echo "${YEL}Paused${R}  : until $(date -d "@$pu" '+%a %d %b %H:%M') (run: oshibot resume)"
  next=$(state_get NEXT 0)
  if [[ -f $UNIT ]] && (( next > $(now) )); then
    echo "Next    : session at $(date -d "@$next" '+%a %H:%M')$( ((SLEEP_MIN > 0)) && echo ", night from $(date -d "@$(state_get BED 0)" +%H:%M) to $(date -d "@$(state_get WAKE 0)" +%H:%M)")$([[ $(state_get LIGHT 0) == 1 ]] && echo ', light day')"
  fi
  load_stats
  echo "Today   : $(recap_line "$(date +%F)")"
}

cmd_install() {
  (( EUID == 0 )) || die "must be run as root"
  command -v systemctl >/dev/null || die "systemd not found, run the loop yourself with: oshibot run"
  [[ -f $SESSION ]] || die "set up the session first: oshibot cookie"
  ensure_profile
  fix_owner
  ln -sf "$DIR/oshibot" /usr/local/bin/oshibot
  cat >"$UNIT" <<EOF
[Unit]
Description=Automatic oshicards free booster opening
After=network-online.target
Wants=network-online.target

[Service]
User=$(stat -c %U "$DIR")
ExecStart=$DIR/oshibot run
Restart=on-failure
RestartSec=60
RestartPreventExitStatus=2 3

[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload
  systemctl enable "$SERVICE" >/dev/null 2>&1
  systemctl restart "$SERVICE" || die "could not start the service"
  ok "service running, follow it with: ${B}oshibot logs${R}"
}

cmd_uninstall() {
  (( EUID == 0 )) || die "must be run as root"
  systemctl disable --now "$SERVICE" >/dev/null 2>&1
  rm -f "$UNIT" /usr/local/bin/oshibot
  systemctl daemon-reload
  ok "service removed (session and settings kept in $DIR)"
}

cmd_setup() {
  local preset url a
  [[ -t 0 ]] || die "setup is interactive, run it in a terminal"
  echo "${B}Step 1/4: account${R}"; echo
  if [[ -f $SESSION ]]; then
    read -r -p "A session already exists for $(jq -r '.user.email // .user.id' "$SESSION"). Replace it? [y/N] > " a
    [[ $a == [yY]* ]] && cmd_cookie
  else
    cmd_cookie
  fi
  echo; echo "${B}Step 2/4: how much do you want to play?${R}"; echo
  preset=$(choose_preset 3>&1 >/dev/tty)
  gen_profile "$preset"
  ok "${B}$preset${R} profile drawn for this install"
  echo; echo "${B}Step 3/4: Discord notifications${R}"; echo
  read -r -p "Webhook URL (Enter to skip) > " url
  if [[ -n $url ]]; then
    cmd_webhook "$url" && cmd_webhook test
  fi
  echo; echo "${B}Step 4/4: background service${R}"; echo
  if (( EUID == 0 )) && command -v systemctl >/dev/null; then
    read -r -p "Install and start the service now? [Y/n] > " a
    [[ $a == [nN]* ]] || cmd_install
  else
    echo "Run ${B}sudo $DIR/oshibot install${R} to start the background loop."
  fi
  echo; cmd_status
}

cmd_help() {
  local c=$CYA d=$DIM
  cat <<EOF

  ${B}oshibot${R}  auto pack opener for oshicards
  ${d}Opens your free boosters at a human pace. Never spends gems.${R}

  ${B}${YEL}GET STARTED${R}
    ${c}oshibot setup${R}                 guided setup, runs the four steps below for you
     ${d}├─${R} ${c}oshibot cookie${R}            ${d}1.${R} connect your account
     ${d}├─${R} ${c}oshibot profile${R} <preset>  ${d}2.${R} pick a play style: chill, regular, grinder, nonstop
     ${d}├─${R} ${c}oshibot webhook${R} <url>     ${d}3.${R} Discord alerts for legendary and mythic pulls
     ${d}└─${R} ${c}oshibot install${R}           ${d}4.${R} start the background service

  ${B}${YEL}EVERY DAY${R}
    ${c}oshibot status${R}                account, profile, next session, today's pulls
    ${c}oshibot stats${R}                 packs and rarities over the last 7 days
    ${c}oshibot open${R} [n]              play one session now (whole free stock, or n packs)
    ${c}oshibot rarer${R}                 play today's "Which is rarer?" mini-game now
    ${c}oshibot pause${R} <duration>      take a break: 3d, 12h, 45m
    ${c}oshibot resume${R}                end a break, or restart after a safety stop
    ${c}oshibot logs${R}                  follow what the service is doing

  ${B}${YEL}SETTINGS${R}
    ${c}oshibot profile${R}               show your current play style
    ${c}oshibot browser${R}               refresh your browser's identity, keeps the session
    ${c}oshibot webhook${R} test|off      send a test message, or remove the webhook

  ${B}${YEL}SERVICE${R}
    ${c}oshibot uninstall${R}             stop and remove the service
    ${c}oshibot run${R}                   run the loop in the foreground

  ${d}If the site answers anything unexpected, oshibot stops itself and alerts you on Discord.${R}

EOF
}

main() {
  local cmd=${1:-help}
  shift || true
  trap fix_owner EXIT
  case $cmd in
    setup) cmd_setup ;;
    cookie) cmd_cookie "$@" ;;
    browser) cmd_browser "$@" ;;
    profile) cmd_profile "$@" ;;
    webhook) cmd_webhook "$@" ;;
    open) cmd_open "$@" ;;
    rarer) ensure_profile; locked play_rarer "$@" ;;
    pause) cmd_pause "$@" ;;
    resume) cmd_resume ;;
    stats) cmd_stats ;;
    run) cmd_run ;;
    status) cmd_status ;;
    install) cmd_install ;;
    uninstall) cmd_uninstall ;;
    logs) exec journalctl -u "$SERVICE" -f -n 50 -o cat ;;
    help | -h | --help) cmd_help ;;
    *) err "unknown command: $cmd"; cmd_help; exit 1 ;;
  esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi
