BROWSER=()
LOCALE="en"
load_browser() {
  local ua="" al="" ch="" plat="" mob="" loc=""
  if [[ -f $DEVICE ]]; then
    IFS=$'\x1f' read -r ua al ch plat mob loc < <(jq -r '.browser // {} |
      [.ua // "", .accept_language // "", .sec_ch_ua // "", .platform // "", (.mobile // false | tostring), .locale // ""] | join("\u001f")' "$DEVICE")
  fi
  if [[ -z $ua ]]; then
    ua="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/157.0.0.0 Safari/537.36"
    al="en-US,en;q=0.9"
    ch='"Not-A.Brand";v="99", "Chromium";v="157", "Google Chrome";v="157"'
    plat="Windows"; mob="false"
  fi
  LOCALE=${loc:-en}
  BROWSER=(-A "$ua" -H "Accept-Language: $al")
  if [[ -n $ch ]]; then
    BROWSER+=(-H "sec-ch-ua: $ch" -H "sec-ch-ua-mobile: $([[ $mob == true ]] && echo '?1' || echo '?0')"
      -H "sec-ch-ua-platform: \"$plat\"")
  fi
}

has_browser() { [[ -f $DEVICE ]] && jq -e '.browser.ua' "$DEVICE" >/dev/null 2>&1; }

# $1 = JSON produced by the console snippet
save_browser() {
  local b
  b=$(jq -c --arg locales "$LOCALES" '
    select(type == "object" and (.ua | type == "string") and (.ua | startswith("Mozilla/"))) |
    (.lang // ["en-US", "en"]) as $l |
    {ua,
     sec_ch_ua: (if (.brands | type) == "array" then (.brands | map("\"\(.brand)\";v=\"\(.version)\"") | join(", ")) else null end),
     platform: (.platform // null),
     mobile: (.mobile // false),
     accept_language: ($l[:5] | to_entries | map(if .key == 0 then .value else "\(.value);q=0.\(10 - .key)" end) | join(",")),
     locale: (($l[0] // "en")[:2] as $c | if ($locales | split(" ") | index($c)) then $c else "en" end)}' <<<"$1" 2>/dev/null)
  [[ -z $b ]] && return 1
  ensure_device
  jq -c --argjson b "$b" '.browser = $b' "$DEVICE" >"$DEVICE.tmp" && mv "$DEVICE.tmp" "$DEVICE"
  load_browser
}

save_site_cookies() {
  local name val
  for name in NEXT_LOCALE oshi_dev oc_visit; do
    val=$(grep -i "^set-cookie: $name=" "$1" | tail -1 | tr -d '\r' | sed -E 's/^[^=]+=([^;]*).*/\1/')
    [[ -z $val ]] && continue
    jq -c --arg n "$name" --arg v "$val" '.cookies[$n]=$v' "$DEVICE" >"$DEVICE.tmp" && mv "$DEVICE.tmp" "$DEVICE"
  done
}

cookie_header() {
  local val i=0 out
  ensure_device
  out=$(jq -r '.cookies | to_entries | map("\(.key)=\(.value); ") | add // ""' "$DEVICE")
  val="base64-$(jq -c . "$SESSION" | tr -d '\n' | base64 -w0 | tr '/+' '_-' | tr -d '=')"
  if (( ${#val} <= 3180 )); then
    echo "Cookie: $out$COOKIE_NAME=$val"; return
  fi
  while [[ -n $val ]]; do
    out+="$COOKIE_NAME.$i=${val:0:3180}; "
    val=${val:3180}
    i=$((i + 1))
  done
  echo "Cookie: ${out%; }"
}

PAGE_CODE=000
PAGE_HTML=""
# loads a page of the site like a browser tab would; $1 = path, default the pack page
visit_page() {
  local hdr path=${1:-/$LOCALE/open/$SLUG}
  hdr=$(mktemp)
  PAGE_HTML=$(mktemp)
  PAGE_CODE=$("$CURL_BIN" -sS -m 30 "${BROWSER[@]}" -H "$(cookie_header)" \
    -H 'Accept: text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,*/*;q=0.8' \
    -H 'sec-fetch-dest: document' -H 'sec-fetch-mode: navigate' -H 'sec-fetch-site: none' \
    -H 'upgrade-insecure-requests: 1' --compressed \
    -D "$hdr" -o "$PAGE_HTML" -w '%{http_code}' "$SITE$path" 2>/dev/null) || PAGE_CODE=000
  [[ $PAGE_CODE == 200 ]] && save_site_cookies "$hdr"
  rm -f "$hdr"
}

# ---------- packs ----------

# the page's data stream, decoded from the scripts of the page saved in $1
page_stream() {
  grep -oP 'self\.__next_f\.push\(\[1,\K"(?:[^"\\]|\\.)*"(?=\]\))' "$1" | jq -rj . 2>/dev/null
}

# prints "slug<TAB>cost<TAB>from<TAB>until<TAB>name" for every pack listed on the volumes page saved in $1
site_packs() {
  page_stream "$1" |
    grep -oP '\{"slug":"[a-z0-9_-]+","name":".*?"available_from":(null|"[^"]*")' |
    while IFS= read -r o; do
      printf '%s\t%s\t%s\t%s\t%s\n' \
        "$(grep -oP '^\{"slug":"\K[^"]+' <<<"$o")" \
        "$(grep -oP '"cost_kind":"\K[^"]+' <<<"$o" | head -1)" \
        "$(grep -oP '"available_from":"?\K[^",]+' <<<"$o" | tail -1)" \
        "$(grep -oP '"available_until":"?\K[^",]+' <<<"$o" | head -1)" \
        "$(grep -oP '^\{"slug":"[^"]+","name":"\K(?:[^"\\]|\\.)*' <<<"$o" | head -1)"
    done | awk -F'\t' '!seen[$1]++'
}

# true when the time window $1 .. $2 (ISO dates or null) contains now
in_window() {
  local t
  t=$(now)
  [[ -z $1 || $1 == null ]] || (( $(date -d "$1" +%s 2>/dev/null || echo 0) <= t )) || return 1
  [[ -z $2 || $2 == null ]] || (( $(date -d "$2" +%s 2>/dev/null || echo 0) > t )) || return 1
}

# picks the pack to open: the first of PACKS that the site offers for free right now
choose_pack() {
  local list=$1 p kind from until name
  if [[ -z $list ]]; then
    # page unreadable: keep the last choice while it is valid
    p=$(state_get PACK "")
    if [[ -n $p ]] && in_window "" "$(state_get PACK_UNTIL null)"; then echo "$p"; else echo standard; fi
    return 0
  fi
  for p in $PACKS; do
    IFS=$'\t' read -r _ kind from until name < <(awk -F'\t' -v s="$p" '$1 == s' <<<"$list")
    if [[ -z $kind ]]; then
      [[ $(state_get "PACK_WARN_$p" "") == "$(date +%F)" ]] || warn "pack $p: not offered by the site, skipped (see: oshibot packs)" >&2
      state_set "PACK_WARN_$p" "$(date +%F)"; continue
    fi
    if [[ $kind != free ]]; then
      [[ $(state_get "PACK_WARN_$p" "") == "$(date +%F)" ]] || warn "pack $p costs $kind, skipped: oshibot only opens free packs" >&2
      state_set "PACK_WARN_$p" "$(date +%F)"; continue
    fi
    in_window "$from" "$until" || continue
    state_set PACK_UNTIL "$until"
    echo "$p"; return 0
  done
  state_set PACK_UNTIL null
  echo standard
}

# ---------- server actions ----------

# The site's buttons call "server actions" whose ids change with every site update.
# Prints the id of action $1, read from the scripts of the page saved in $2.
find_action() {
  local name=$1 html=$2 cached id chunk url found
  cached=$(state_get "ACT_$name" "")
  id=${cached%%|*}; chunk=${cached#*|}
  if [[ -n $id && $cached == *"|"* ]] && grep -qF "$chunk" "$html"; then
    echo "$id"; return 0
  fi
  for url in $(grep -oE '/_next/static/[^"\\ ?]+\.js(\?dpl=[A-Za-z0-9_.-]+)?' "$html" | sort -u); do
    found=$("$CURL_BIN" -sS -m 30 "${BROWSER[@]}" -H 'Accept: */*' -H "Referer: $SITE/" \
      -H 'sec-fetch-dest: script' -H 'sec-fetch-mode: no-cors' -H 'sec-fetch-site: same-origin' --compressed \
      "$SITE$url" 2>/dev/null |
      grep -oE '"[0-9a-f]{42}",[A-Za-z_$]+\.callServer,void 0,[A-Za-z_$]+\.findSourceMapURL,"'"$name"'"' | head -1)
    if [[ -n $found ]]; then
      state_set "ACT_$name" "${found:1:42}|${url%%\?*}"
      echo "${found:1:42}"; return 0
    fi
  done
  return 1
}

# calls action $1 from page path $2 with JSON arguments $3; $4 = that page's saved html
ACT_STATUS=000
ACT_BODY=""
call_action() {
  local id out
  ACT_STATUS=000; ACT_BODY=""
  id=$(find_action "$1" "$4") || { ACT_STATUS=404; return 1; }
  out=$("$CURL_BIN" -sS -m 30 "${BROWSER[@]}" -H "$(cookie_header)" -H 'Accept: text/x-component' \
    -H 'Content-Type: text/plain;charset=UTF-8' -H "Next-Action: $id" \
    -H "Origin: $SITE" -H "Referer: $SITE$2" \
    -H 'sec-fetch-dest: empty' -H 'sec-fetch-mode: cors' -H 'sec-fetch-site: same-origin' --compressed \
    -d "$3" -w $'\n%{http_code}' "$SITE$2" 2>/dev/null) || return 1
  ACT_STATUS=${out##*$'\n'}
  if [[ $ACT_STATUS != 200 ]]; then
    state_set "ACT_$1" ""
    return 1
  fi
  ACT_BODY=$(grep -m1 '^1:' <<<"$out" | cut -c3-)
  [[ -n $ACT_BODY ]]
}

# The site's pages claim the daily login reward by themselves when they load.
daily_login() {
  local html=$1 bonus
  (( DAILY_LOGIN )) || return 0
  if ! call_action claimDailyLogin "/$LOCALE/open/$SLUG" '[]' "$html"; then
    case $ACT_STATUS in
      000) ;;
      404) warn "daily login: not found in the site's code, skipped" ;;
      *) warn "daily login: the site answered HTTP $ACT_STATUS, skipped" ;;
    esac
    return 0
  fi
  jq -e '.day' >/dev/null 2>&1 <<<"$ACT_BODY" || return 0
  state_set LOGIN_DAY "$(jq -r '"\(.day)/\(.cycle // 7)"' <<<"$ACT_BODY")"
  if [[ $(jq -r '.claimed' <<<"$ACT_BODY") == true ]]; then
    ok "daily login claimed: day $(state_get LOGIN_DAY "?")"
  fi
  if [[ $(jq -r '.claimed or (.state.login_claimed_today // false)' <<<"$ACT_BODY") == true ]]; then
    state_set LOGIN_DATE "$(date -d "@$(now)" +%F)"
  fi
  bonus=$(jq -r '.state.bonus_boosters // empty' <<<"$ACT_BODY")
  [[ $bonus =~ ^[0-9]+$ ]] && state_set BONUS "$bonus"
  return 0
}

LAST_PING=0
presence_ping() {
  (( $(now) - LAST_PING < 60 )) && return 0
  LAST_PING=$(now)
  http_post "$SUPABASE/rest/v1/rpc/presence_ping" \
    "$(jq -c '{p_key:.presence_key}' "$DEVICE")" "${BROWSER[@]}" \
    -H "apikey: $APIKEY" -H "Authorization: Bearer $(jq -r .access_token "$SESSION")" \
    -H 'content-profile: public' -H 'x-client-info: supabase-ssr/0.12.7 createBrowserClient' \
    -H "Origin: $SITE" -H "Referer: $SITE/"
}

# sleeps while keeping presence alive, like an open tab
idle() {
  local left=$1 step
  while (( left > 0 )); do
    step=$(( left < 20 ? left : 20 ))
    sleep "$step"
    left=$((left - step))
    presence_ping
  done
}

# ---------- discord ----------

discord_send() {
  [[ -z $WEBHOOK ]] && return 0
  http_post "$WEBHOOK" "$1"
  [[ $HTTP_STATUS == 2* ]] || warn "Discord webhook failed ($HTTP_STATUS)"
}

# routine news waits for the daily recap instead of posting right away
digest_add() {
  printf '%s\t%s\n' "$(date +%F)" "$1" >>"$DIGEST"
}

discord_text() {
  discord_send "$(jq -nc --arg c "$1" '{username:"oshibot", content:$c}')"
}

# event editions have no copy number: their name comes from the variant code (rivals_2026 -> Rivals)
JQ_EDITION='def edition: if (.variant | type) == "object" and .variant.code then
  (.variant.code | sub("_[0-9]{4}"; "") | gsub("_"; " ") | (.[:1] | ascii_upcase) + .[1:]) else null end;'

loot_payload() {
  jq -c --argjson rar "$NOTIFY_RARITIES" "$JQ_EDITION"'
    [.result.boosters[].cards[] | select(.rarity as $r | $rar | index($r))]
    | if length == 0 then empty else
      {username: "Oshi", embeds: (.[:10] | map({
        title: ((.rarity | ascii_upcase) + ": " + .name),
        description: (.series_title // ""),
        color: (if .rarity == "mythic" then 15680580 else 16096779 end),
        thumbnail: {url: ((.variant | objects | .image) // .image_url)},
        fields: (
          (if .serial then [{name: "Serial", value: "#\(.serial)\(if .total then " / \(.total)" else "" end)", inline: true}] else [] end)
          + (if edition then [{name: "Edition", value: edition, inline: true}] else [] end)
          + [{name: "New", value: (if .is_new then "yes" else "no" end), inline: true}])
      }))}
    end' <<<"$1"
}

# ---------- safety stop ----------

halt() {
  echo "$1" >"$HALT"
  err "stopped: $1"
  err "check your account in a browser, then run: ${B}oshibot resume${R}"
  discord_text "oshibot stopped itself: $1. Check your account in a browser, then run \`oshibot resume\`."
}

# unexpected answer: tell a dead session (2) apart from a refusal by the site (3)
stop_or_expired() {
  refresh_session "$(jq -r .refresh_token "$SESSION")"
  (( $? == 2 )) && return 2
  halt "$1"
  return 3
}

# ---------- stats ----------

declare -A S_PACKS=() S_RARE=() S_EPIC=() S_LEG=() S_MYTH=()
load_stats() {
  S_PACKS=(); S_RARE=(); S_EPIC=(); S_LEG=(); S_MYTH=()
  [[ -f $HISTORY ]] || return 0
  local ts rar day r
  while IFS=$'\t' read -r ts rar _; do
    [[ $ts =~ ^[0-9]+$ ]] || continue
    printf -v day '%(%F)T' "$ts"
    S_PACKS[$day]=$(( ${S_PACKS[$day]:-0} + 1 ))
    for r in ${rar//,/ }; do
      case $r in
        rare) S_RARE[$day]=$(( ${S_RARE[$day]:-0} + 1 )) ;;
        epic) S_EPIC[$day]=$(( ${S_EPIC[$day]:-0} + 1 )) ;;
        legendary) S_LEG[$day]=$(( ${S_LEG[$day]:-0} + 1 )) ;;
        mythic) S_MYTH[$day]=$(( ${S_MYTH[$day]:-0} + 1 )) ;;
      esac
    done
  done <"$HISTORY"
}

recap_line() {
  local d=$1
  echo "${S_PACKS[$d]:-0} packs, ${S_RARE[$d]:-0} rare, ${S_EPIC[$d]:-0} epic, ${S_LEG[$d]:-0} legendary, ${S_MYTH[$d]:-0} mythic"
}

# ---------- opening ----------

print_cards() {
  jq -r "$JQ_EDITION"'.result.boosters[].cards[] | "\(.rarity)\t\(.name)\(if edition then " [\(edition)]" else "" end)\t\((.series_title // "")[:50])\t\(if .is_new then "NEW" else "" end)"' <<<"$1" |
  while IFS=$'\t' read -r rar name series new; do
    local c=$DIM
    case $rar in
      *rare) c=$CYA ;;
      *epic) c=$YEL ;;
      *legendary | *mythic) c=$B$RED ;;
    esac
    printf '           %s%-10s%s %s %s(%s)%s %s\n' "$c" "$rar" "$R" "$name" "$DIM" "$series" "$R" "${new:+${GRN}$new${R}}"
  done
}

# one play session: loads the page, then opens up to $1 packs.
# 0 = ok, 2 = dead session, 3 = safety stop
play_session() {
  local want=$1 opened=0 i key payload body rc pause next_free fails free bonus list full=0 ret=0
  (( want >= $(max_packs) )) && full=1
  bonus=$(state_get BONUS 0)
  (( USE_BONUS )) || bonus=0
  if [[ -f $HALT ]]; then
    err "stopped earlier: $(<"$HALT") (run: ${B}oshibot resume${R})"; return 3
  fi
  next_free=$(state_get NEXT_FREE 0)
  if (( $(now) < next_free && bonus <= 0 )); then
    log "no free booster before $(date -d "@$next_free" +%H:%M)"; return 0
  fi
  load_browser
  ensure_session; rc=$?
  (( rc == 2 )) && return 2
  (( rc == 1 )) && { warn "network unavailable, session postponed"; return 0; }

  if [[ -n $FORCE_PACK ]]; then
    SLUG=$FORCE_PACK
  else
    # land on the volumes page like a player, and pick the pack there
    visit_page "/$LOCALE/volumes"
    list=""
    [[ $PAGE_CODE == 200 ]] && list=$(site_packs "$PAGE_HTML")
    rm -f "$PAGE_HTML"
    case $PAGE_CODE in
      403 | 429) halt "the volumes page answered HTTP $PAGE_CODE, the site may be blocking this tool"; return 3 ;;
    esac
    SLUG=$(choose_pack "$list")
    idle "$(rand 3 10)"
  fi
  if [[ $SLUG != "$(state_get PACK "")" ]]; then
    log "opening ${B}$SLUG${R} packs"
    state_set PACK "$SLUG"
  fi

  visit_page
  if [[ $PAGE_CODE == 200 ]]; then
    idle "$(rand 1 3)"
    daily_login "$PAGE_HTML"
  fi
  rm -f "$PAGE_HTML"
  case $PAGE_CODE in
    200) state_set PAGE_FAILS 0 ;;
    403 | 429) halt "the pack page answered HTTP $PAGE_CODE, the site may be blocking this tool"; return 3 ;;
    000 | 5*) warn "pack page unreachable ($PAGE_CODE), session postponed"; return 0 ;;
    *)
      # redirected to the login page or similar: renew the session, give up after 3 tries
      fails=$(( $(state_get PAGE_FAILS 0) + 1 ))
      state_set PAGE_FAILS "$fails"
      refresh_session "$(jq -r .refresh_token "$SESSION")"
      (( $? == 2 )) && return 2
      if (( fails >= 3 )); then
        halt "the pack page keeps answering HTTP $PAGE_CODE"; return 3
      fi
      warn "pack page answered HTTP $PAGE_CODE, session renewed and postponed"; return 0 ;;
  esac
  LAST_PING=0
  presence_ping
  idle "$(rand 4 12)"

  for ((i = 1; i <= want; i++)); do
    ensure_session; rc=$?
    (( rc == 2 )) && return 2
    (( rc == 1 )) && { warn "network unavailable"; break; }

    http_post "$SITE/api/open" \
      "$(jq -nc --arg s "$SLUG" --arg id "$(cat /proc/sys/kernel/random/uuid)" \
        '{slug:$s, quantity:1, maxGems:0, requestId:$id}')" \
      "${BROWSER[@]}" -H "$(cookie_header)" -H 'Accept: */*' \
      -H "Origin: $SITE" -H "Referer: $SITE/$LOCALE/open/$SLUG" \
      -H 'sec-fetch-dest: empty' -H 'sec-fetch-mode: cors' -H 'sec-fetch-site: same-origin'

    case $HTTP_STATUS in
      200) ;;
      000 | 5*) warn "server unavailable ($HTTP_STATUS)"; break ;;
      403 | 429) halt "opening a pack answered HTTP $HTTP_STATUS, the site may be blocking this tool"; ret=3; break ;;
      *) stop_or_expired "opening a pack answered HTTP $HTTP_STATUS"; ret=$?; break ;;
    esac
    key=$(jq -r '.errorKey // empty' <<<"$HTTP_BODY" 2>/dev/null)
    if [[ $key == stockChanged ]]; then
      log "no free booster available"; break
    elif [[ -n $key ]]; then
      stop_or_expired "opening a pack was refused with error \"$key\""; ret=$?; break
    elif ! jq -e .result.boosters >/dev/null 2>&1 <<<"$HTTP_BODY"; then
      stop_or_expired "opening a pack returned an unknown response"; ret=$?; break
    fi

    body=$HTTP_BODY
    opened=$((opened + 1))
    (( opened == 1 )) && learn_stock "$body"
    log "${B}pack $opened${R}$([[ $SLUG != standard ]] && echo " ($SLUG)")$(jq -r '(if (.result.paid.bonus // 0) > 0 then " (bonus)" else "" end) + (if any(.result.boosters[]; .golden) then " (golden)" else "" end)' <<<"$body")"
    print_cards "$body"
    printf '%s\t%s\t%s\n' "$(now)" "$(jq -r '[.result.boosters[].cards[].rarity] | join(",")' <<<"$body")" "$SLUG" >>"$HISTORY"
    jq -r '.result.boosters[].cards[] | [.card_id, .rarity, .name, (.series_title // "")] | @tsv' <<<"$body" 2>/dev/null | learn_cards
    payload=$(loot_payload "$body")
    [[ -n $payload ]] && discord_send "$payload"

    if (( $(jq -r '.result.paid.gems // 0' <<<"$body") > 0 )); then
      halt "a pack was paid with gems instead of a free booster"; ret=3; break
    fi
    free=$(jq -r '.result.state.free_boosters // 0' <<<"$body")
    bonus=$(jq -r '.result.state.bonus_boosters // 0' <<<"$body")
    state_set BONUS "$bonus"
    if (( free <= 0 )); then
      next_free=$(date -d "$(jq -r '.result.state.next_free_at // empty' <<<"$body")" +%s 2>/dev/null) || next_free=0
      state_set NEXT_FREE "$next_free"
    else
      state_set NEXT_FREE 0
    fi
    (( USE_BONUS )) || bonus=0
    (( free + bonus <= 0 )) && break
    # a full session empties everything that is left, bonus boosters included
    (( full )) && want=$(( i + free + bonus ))
    if (( i < want )); then
      pause=$(rand $PACK_PAUSE_MIN $PACK_PAUSE_MAX)
      (( $(rand 1 100) <= LONG_PAUSE_CHANCE )) && pause=$((pause + $(rand $LONG_PAUSE_MIN $LONG_PAUSE_MAX)))
      idle "$pause"
    fi
  done
  state_set LAST_SESSION "$(now)"
  (( ret == 2 )) && err "the session is no longer valid"
  ok "$opened pack(s) opened"
  return $ret
}

locked() {
  exec 9>"$LOCK"
  flock -w 600 9 || die "another session is already running"
  "$@"; local rc=$?
  flock -u 9
  return $rc
}

locked_session() { locked play_session "$1"; }

# ---------- mini-games ----------

paris_day() { TZ=Europe/Paris date -d "@$(now)" +%F; }

# AniList character id, read from a card's image address
card_id_of() {
  local base=${1##*/}
  [[ $base =~ ^[a-z]?([0-9]+) ]] && echo "${BASH_REMATCH[1]}"
}

# Every card seen (opened packs, cards revealed by the games) is kept locally with its
# true rarity and anime: popularity alone misses the classics the site always makes Mythic.
rarity_rank() {
  case $1 in
    common) echo 1 ;; uncommon) echo 2 ;; rare) echo 3 ;; epic) echo 4 ;; legendary) echo 5 ;; mythic) echo 6 ;;
    *) echo 0 ;;
  esac
}

known_rarity() {
  [[ -f $RARITIES ]] || return 0
  awk -F'\t' -v id="$1" '$1 == id { r = $2 } END { print r }' "$RARITIES"
}

known_series() {
  [[ -f $RARITIES ]] || return 0
  awk -F'\t' -v id="$1" '$1 == id && $4 != "" { r = $4 } END { print r }' "$RARITIES"
}

# reads "id<TAB>rarity<TAB>name<TAB>anime" lines on stdin
learn_cards() {
  local id rar name series
  while IFS=$'\t' read -r id rar name series; do
    [[ $id =~ ^[0-9]+$ ]] && (( $(rarity_rank "$rar") > 0 )) || continue
    if [[ $(known_rarity "$id") != "$rar" || ( -n $series && $(known_series "$id") != "$series" ) ]]; then
      printf '%s\t%s\t%s\t%s\n' "$id" "$rar" "$name" "$series" >>"$RARITIES"
    fi
  done
}

# prints the AniList favourites of characters $1 and $2 ("" when unknown). Rarity follows popularity.
anilist_favs() {
  local out
  out=$("$CURL_BIN" -sS -m 20 -X POST https://graphql.anilist.co \
    -H 'Content-Type: application/json' -H 'Accept: application/json' \
    -d "$(jq -nc --argjson a "$1" --argjson b "$2" \
      '{query: "query($ids:[Int]){Page(perPage:5){characters(id_in:$ids){id favourites}}}", variables: {ids: [$a, $b]}}')" \
    2>/dev/null) || return 1
  jq -r --argjson a "$1" --argjson b "$2" '
    (.data.Page.characters // []) as $c
    | "\(first($c[] | select(.id == $a) | .favourites) // "") \(first($c[] | select(.id == $b) | .favourites) // "")"' <<<"$out" 2>/dev/null
}

# the anime of card $1, as the site names it: from the local file, else from the card's page
series_of() {
  local id=$1 title
  title=$(known_series "$id")
  if [[ -z $title ]]; then
    title=$("$CURL_BIN" -sS -m 30 "${BROWSER[@]}" -H "$(cookie_header)" -H 'Accept: text/html' \
      -H "Referer: $SITE$G_PATH" --compressed "$SITE/$LOCALE/card/$id" 2>/dev/null |
      grep -oP '\\"series_title\\":\\"\K.*?(?=\\",)' | head -1)
    [[ -n $title ]] && title=$(printf '"%s"' "$title" | jq -r . 2>/dev/null)
  fi
  echo "$title"
}

G_PLAY=""
G_HTML=""
G_PATH=""
GAMES_SUMMARY=""
pj() { jq -r "$1" <<<"$G_PLAY" 2>/dev/null; }

# Opens the page of game $1 and gets today's rewarded play ready in G_PLAY ($2 = free: a replay
# with no reward). 0 = ready, 1 = nothing to play, 2 = dead session, 3 = safety stop
game_begin() {
  local game=$1 free=${2:-} rc esc played
  G_PATH="/$LOCALE/games/$game"; G_PLAY=""; G_HTML=""
  if [[ -f $HALT ]]; then
    err "stopped earlier: $(<"$HALT") (run: ${B}oshibot resume${R})"; return 3
  fi
  load_browser
  ensure_session; rc=$?
  (( rc == 2 )) && return 2
  (( rc == 1 )) && { warn "network unavailable, game postponed"; return 1; }

  visit_page "$G_PATH"
  G_HTML=$PAGE_HTML
  case $PAGE_CODE in
    200) ;;
    403 | 429) halt "the game page answered HTTP $PAGE_CODE, the site may be blocking this tool"; return 3 ;;
    *) warn "game page unreachable ($PAGE_CODE), game postponed"; return 1 ;;
  esac
  LAST_PING=0
  presence_ping

  # the page carries the state of today's game: finished, in progress, or not started
  esc=$(grep -oP '\\"game\\":\\"'"$game"'\\",\\"gems\\":\d+,\\"play\\":\K.*?(?=,\\"played\\":(true|false))' "$G_HTML" | head -1)
  played=$(grep -oP '\\"game\\":\\"'"$game"'\\",\\"gems\\":\d+,\\"play\\":.*?,\\"played\\":\K(true|false)' "$G_HTML" | head -1)
  [[ -n $esc && $esc != null ]] && G_PLAY=$(printf '"%s"' "$esc" | jq -r . 2>/dev/null | jq -c . 2>/dev/null)
  [[ -n $G_PLAY && $(pj .finished) == true ]] && G_PLAY=""
  if [[ -z $free && $played == true && -z $G_PLAY ]]; then
    state_set "GAME_${game}_DAY" "$(paris_day)"
    log "$game: already played today"; return 1
  fi
  if [[ -z $G_PLAY ]]; then
    idle "$(rand 2 5)"
    if ! call_action gameStartAction "$G_PATH" "$(jq -nc --arg g "$game" '[$g]')" "$G_HTML"; then
      if [[ $ACT_STATUS == 403 || $ACT_STATUS == 429 ]]; then
        halt "starting a game answered HTTP $ACT_STATUS, the site may be blocking this tool"; return 3
      fi
      warn "$game: could not start a game (HTTP $ACT_STATUS)"; return 1
    fi
    G_PLAY=$(jq -c '.play // empty' <<<"$ACT_BODY" 2>/dev/null)
    if [[ -z $G_PLAY ]]; then
      warn "$game: $(jq -r '.error // "no game returned"' <<<"$ACT_BODY" 2>/dev/null)"; return 1
    fi
  fi
  if [[ -z $free && $(pj .rewarded) != true ]]; then
    state_set "GAME_${game}_DAY" "$(paris_day)"
    log "$game: today's rewarded game is already used"; return 1
  fi
  return 0
}

# sends answer $1 for the current play and loads the new state; 1 when the site refuses it
game_answer() {
  local next game
  game=$(pj .game)
  if ! call_action gameAnswerAction "$G_PATH" "$(jq -nc --argjson id "$(pj .id)" --arg a "$1" '[$id, $a]')" "$G_HTML"; then
    if [[ $ACT_STATUS == 403 || $ACT_STATUS == 429 ]]; then
      halt "a game answer got HTTP $ACT_STATUS, the site may be blocking this tool"
    else
      warn "$game: answer refused (HTTP $ACT_STATUS), game left for later"
    fi
    return 1
  fi
  next=$(jq -c '.play // empty' <<<"$ACT_BODY" 2>/dev/null)
  if [[ -z $next ]]; then
    warn "$game: $(jq -r '.error // "no answer returned"' <<<"$ACT_BODY" 2>/dev/null)"; return 1
  fi
  G_PLAY=$next
}

# "Which is rarer?": ten rounds of two cards, one wrong answer ends the game
game_rarer() {
  local round ida idb fa fb ra rb pick how names
  for ((round = 1; round <= 30; round++)); do
    [[ $(pj .finished) == true ]] && break
    ida=$(card_id_of "$(pj '.cards[0].image_url // ""')")
    idb=$(card_id_of "$(pj '.cards[1].image_url // ""')")
    ra=$(rarity_rank "$(known_rarity "${ida:-0}")")
    rb=$(rarity_rank "$(known_rarity "${idb:-0}")")
    fa=""; fb=""
    if (( ra > 0 && rb > 0 && ra != rb )); then
      how="known rarities"
      pick=0; (( rb > ra )) && pick=1
    elif (( ra == 6 || rb == 6 )); then
      how="known mythic"
      pick=0; (( rb == 6 )) && pick=1
    else
      [[ -n $ida && -n $idb ]] && read -r fa fb < <(anilist_favs "$ida" "$idb")
      if [[ ! $fa =~ ^[0-9]+$ || ! $fb =~ ^[0-9]+$ ]]; then
        warn "rarer: popularity unknown for this pair, game left for later"; return 0
      fi
      how="$fa vs $fb favourites"
      pick=0; (( fb > fa )) && pick=1
    fi
    names="$(pj '.cards | map(.name) | join(" vs ")'), picked $(pj ".cards[$pick].name")"
    idle "$(rand 1 5)"
    game_answer "$pick" || return 0
    log "rarer, round $round: $names ($how) $([[ $(pj .last.correct) == true ]] && echo "${GRN}correct${R}" || echo "${RED}wrong${R}")"
    pj '.last.cards // [] | .[] | select(.rarity != null) | [.card_id, .rarity, .name, (.series_title // "")] | @tsv' | learn_cards
  done
}

# "Mystery anime": name the anime of the character shown, up to three clues
game_anime() {
  local try n id title answer
  for ((try = 1; try <= 6; try++)); do
    [[ $(pj .finished) == true ]] && break
    n=$(pj '.clues | length')
    id=$(card_id_of "$(pj ".clues[$((n - 1))].image_url // \"\"")")
    title=""
    [[ -n $id ]] && title=$(series_of "$id")
    answer=$title
    # an answer already refused is not tried twice: ask for the next clue instead
    [[ -n $answer ]] && pj '.log // [] | .[]' | grep -qixF -- "$answer" && answer=""
    idle "$(rand 4 9)"
    game_answer "$answer" || return 0
    if [[ -z $answer ]]; then
      log "anime, clue $n ($(pj ".clues[$((n - 1))].name")): anime unknown, next clue"
    else
      log "anime, clue $n: answered \"$answer\" $([[ $(pj .last.correct) == true ]] && echo "${GRN}correct${R}" || echo "${RED}wrong${R}")"
    fi
  done
  pj '.clues // [] | .[] | select(.rarity != null) | [.card_id, .rarity, .name, (.series_title // "")] | @tsv' | learn_cards
}

# "Memory": six pairs face down. Nothing is revealed before a card is flipped, so it is played
# by remembering every card seen.
game_memory() {
  local -A seen=()
  local size guard=0 first second card p found
  size=$(pj '.size // 12')

  memory_flip() {
    idle "$(rand 1 3)"
    game_answer "$1" || return 1
    card=$(pj '.last.card.image_url // ""')
    [[ -n $card ]] && seen[$1]=$card
    return 0
  }
  # a position still face down: $1 = unseen | any, $2 = position to avoid
  memory_pick() {
    local q
    for q in $(shuf -i "0-$((size - 1))"); do
      [[ $found == *" $q "* || $q == "${2:-}" ]] && continue
      [[ $1 == unseen && -n ${seen[$q]:-} ]] && continue
      echo "$q"; return 0
    done
    return 1
  }
  # the position of a remembered card equal to $1, other than position $2
  memory_twin() {
    local q
    for q in "${!seen[@]}"; do
      [[ $q != "$2" && $found != *" $q "* && ${seen[$q]} == "$1" ]] && { echo "$q"; return 0; }
    done
    return 1
  }

  while [[ $(pj .finished) != true ]] && (( guard++ < 60 )); do
    found=" $(pj '.found // [] | join(" ")') "
    first=$(pj '.open // empty')
    if [[ -z $first ]]; then
      # flip a remembered pair when there is one, else discover a new card
      first=""
      for p in "${!seen[@]}"; do
        [[ $found == *" $p "* ]] && continue
        if memory_twin "${seen[$p]}" "$p" >/dev/null; then first=$p; break; fi
      done
      [[ -z $first ]] && first=$(memory_pick unseen) || true
      [[ -z $first ]] && first=$(memory_pick any) || true
      [[ -z $first ]] && break
      memory_flip "$first" || return 0
      [[ $(pj .finished) == true ]] && break
    fi
    second=""
    [[ -n ${seen[$first]:-} ]] && second=$(memory_twin "${seen[$first]}" "$first") || true
    [[ -z $second ]] && second=$(memory_pick unseen "$first") || true
    [[ -z $second ]] && second=$(memory_pick any "$first") || true
    [[ -z $second ]] && break
    memory_flip "$second" || return 0
  done
  log "memory: $(pj '"\(.found // [] | length / 2 | floor) pairs found in \(.moves // .step) moves"')"
}

game_result() {
  case $1 in
    rarer) pj '"\(.score // 0)/\(.rounds // 10), +\(.gems // 0) gems"' ;;
    anime) pj '(if .won then "found at clue \((.step // 0) + 1)" else "missed" end) + ", +\(.gems // 0) gems"' ;;
    memory) pj '"\(.moves // .step) moves, +\(.gems // 0) gems"' ;;
  esac
}

# plays one game. 0 = done or skipped, 2 = dead session, 3 = safety stop
play_game() {
  local game=$1 free=${2:-} rc result
  game_begin "$game" "$free"; rc=$?
  if (( rc == 0 )); then
    "game_$game"
    if [[ $(pj .finished) == true ]]; then
      result=$(game_result "$game")
      ok "$game: $result"
      if [[ -z $free ]]; then
        state_set "GAME_${game}_DAY" "$(paris_day)"
        state_set "GAME_${game}_RESULT" "$result"
        GAMES_SUMMARY+="${GAMES_SUMMARY:+; }$game $result"
      fi
    fi
  fi
  [[ -n $G_HTML ]] && rm -f "$G_HTML"
  [[ -f $HALT ]] && return 3
  (( rc >= 2 )) && return $rc
  return 0
}

# plays the games given ($@, default PLAY_GAMES) that are still to play today; "free" = unrewarded replays
play_games() {
  local a g free="" rc=0 first=1
  local -a list=()
  for a in "$@"; do
    case $a in
      free) free=free ;;
      anime | rarer | memory | quiz) list+=("$a") ;;
      *) die "unknown game: $a (anime, rarer, memory or quiz)" ;;
    esac
  done
  (( ${#list[@]} )) || read -r -a list <<<"${PLAY_GAMES:-anime rarer memory}"
  GAMES_SUMMARY=""
  for g in "${list[@]}"; do
    [[ -z $free && $(state_get "GAME_${g}_DAY" "") == "$(paris_day)" ]] && continue
    (( first )) || sleep "$(rand 15 60)"
    first=0
    if [[ $g == quiz ]]; then
      [[ -n $free ]] && continue
      play_quiz; rc=$?
    else
      play_game "$g" "$free"; rc=$?
    fi
    (( rc >= 2 )) && break
  done
  [[ -n $GAMES_SUMMARY ]] && digest_add "Mini-games: $GAMES_SUMMARY"
  if (( rc == 0 && CLAIM_MISSIONS )) && [[ -z $free ]]; then
    sleep "$(rand 5 20)"
    claim_missions; rc=$?
  fi
  return $rc
}

# true when a game is still to play today and its random time of day has come
games_due() {
  [[ -n $PLAY_GAMES ]] || return 1
  local today g todo=0
  today=$(paris_day)
  for g in $PLAY_GAMES; do
    [[ $(state_get "GAME_${g}_DAY" "") == "$today" ]] || todo=1
  done
  (( todo )) || return 1
  if [[ $(state_get GAME_DAY "") != "$today" ]]; then
    state_set GAME_DAY "$today"
    state_set GAME_AT $(( $(TZ=Europe/Paris date -d "$today 00:00" +%s) + $(rand 32400 72000) ))
  fi
  (( $(now) >= $(state_get GAME_AT 0) ))
}

# ---------- daily quiz: who is it? ----------

# Compares the pixelated picture $1 with the candidates listed in $2 ("name<TAB>image path").
# Prints "name<TAB>distance<TAB>second name<TAB>ratio"; ratio = how much better the best one is.
quiz_match() {
  python3 -I - "$1" "$2" <<'PY'
import sys, html
from PIL import Image
GW, GH = 10, 15
def grid(path):
    im = Image.open(path).convert("RGB")
    w, h = im.size
    tw, th = (w, w * 3 // 2) if h * 2 >= w * 3 else (h * 2 // 3, h)
    im = im.crop(((w - tw) // 2, 0, (w - tw) // 2 + tw, th)).resize((GW, GH), Image.BOX)
    return list(im.getdata())
q = grid(sys.argv[1])
best = {}
for line in open(sys.argv[2], encoding="utf-8"):
    name, path = line.rstrip("\n").split("\t")
    try:
        g = grid(path)
    except Exception:
        continue
    d = sum((a - b) ** 2 for p, r in zip(q, g) for a, b in zip(p, r)) / len(q)
    name = html.unescape(name)
    if name not in best or d < best[name]:
        best[name] = d
res = sorted((d, n) for n, d in best.items())
if not res:
    sys.exit(1)
b = res[0]
s = res[1] if len(res) > 1 else (float("inf"), "")
print(f"{b[1]}\t{b[0]:.0f}\t{s[1]}\t{(s[0] / b[0]) if b[0] else 99:.2f}")
PY
}

# the site's address for an anime title: "Komi Can't Communicate" -> komi-can-t-communicate
anime_slug() {
  tr '[:upper:]' '[:lower:]' <<<"$1" | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//' | cut -c1-80 | sed -E 's/-+$//'
}

QUIZ_STATE=""
quiz_read_state() {
  QUIZ_STATE=$(page_stream "$1" | grep -oP '"initial":\K\{"day":".*?"max_tries":\d+\}' | head -1)
  jq -e .day >/dev/null 2>&1 <<<"$QUIZ_STATE"
}

quiz_guess() {
  local st
  if ! call_action quizGuessAction "/$LOCALE/quiz" "$(jq -nc --arg g "$1" '[$g]')" "$QUIZ_HTML"; then
    [[ $ACT_STATUS == 403 || $ACT_STATUS == 429 ]] && { halt "a quiz guess answered HTTP $ACT_STATUS"; return 3; }
    warn "quiz: guess refused (HTTP $ACT_STATUS)"; return 1
  fi
  st=$(jq -c '.state // empty' <<<"$ACT_BODY" 2>/dev/null)
  if [[ -z $st ]]; then
    warn "quiz: $(jq -r '.error // "no answer returned"' <<<"$ACT_BODY" 2>/dev/null)"; return 1
  fi
  QUIZ_STATE=$st
}

# Plays the daily quiz: two throwaway guesses reveal the anime, then the pixelated picture is
# compared with that anime's cards. The last guess is only sent when one card clearly stands out,
# otherwise you get the candidates on Discord. 0 = done or skipped, 2 = dead session, 3 = safety stop
QUIZ_HTML=""
play_quiz() {
  local rc today tries hint slug dir html list match name dist second ratio n junk played=0
  today=$(paris_day)
  python3 -I -c 'import PIL' 2>/dev/null || { warn "quiz: Pillow is missing (apt install python3-pil), skipped"; return 0; }
  [[ -f $HALT ]] && { err "stopped earlier: $(<"$HALT") (run: ${B}oshibot resume${R})"; return 3; }
  load_browser
  ensure_session; rc=$?
  (( rc == 2 )) && return 2
  (( rc == 1 )) && return 0
  visit_page "/$LOCALE/quiz"
  QUIZ_HTML=$PAGE_HTML
  case $PAGE_CODE in
    200) ;;
    403 | 429) rm -f "$QUIZ_HTML"; halt "the quiz page answered HTTP $PAGE_CODE, the site may be blocking this tool"; return 3 ;;
    *) rm -f "$QUIZ_HTML"; warn "quiz page unreachable ($PAGE_CODE)"; return 0 ;;
  esac
  if ! quiz_read_state "$QUIZ_HTML"; then
    rm -f "$QUIZ_HTML"; warn "quiz: could not read today's quiz"; return 0
  fi
  if [[ $(jq -r .finished <<<"$QUIZ_STATE") == true ]]; then
    rm -f "$QUIZ_HTML"
    state_set GAME_quiz_DAY "$today"
    state_set GAME_quiz_RESULT "$(jq -r 'if .solved then "found \(.answer.name // ""), +\(.gems // 0) gems" else "missed" end' <<<"$QUIZ_STATE")"
    log "quiz: already played today"; return 0
  fi
  LAST_PING=0
  presence_ping

  # throwaway guesses until the anime is given
  for ((n = 0; n < 3; n++)); do
    [[ $(jq -r .finished <<<"$QUIZ_STATE") == true || -n $(jq -r '.hint // empty' <<<"$QUIZ_STATE") ]] && break
    (( $(jq -r '.max_tries - .tries' <<<"$QUIZ_STATE") > 1 )) || break
    junk=$(shuf -n1 -e "je sais pas" "aucune idée" "hmm" "?" "jsp" "pas la moindre idée")
    idle "$(rand 4 12)"
    quiz_guess "$junk"; rc=$?
    (( rc == 3 )) && { rm -f "$QUIZ_HTML"; return 3; }
    (( rc == 1 )) && { rm -f "$QUIZ_HTML"; return 0; }
  done

  if [[ $(jq -r .finished <<<"$QUIZ_STATE") != true ]]; then
    hint=$(jq -r '.hint // empty' <<<"$QUIZ_STATE")
    tries=$(jq -r .tries <<<"$QUIZ_STATE")
    if [[ -z $hint ]]; then
      rm -f "$QUIZ_HTML"; warn "quiz: no hint given, left for you"; return 0
    fi
    if [[ $(state_get QUIZ_ASKED "") == "$today" ]]; then
      rm -f "$QUIZ_HTML"; log "quiz: waiting for you to finish it"; return 0
    fi
    dir=$(mktemp -d)
    slug=$(anime_slug "$hint")
    visit_page "/$LOCALE/anime/$slug"
    html=$PAGE_HTML
    if [[ $PAGE_CODE == 200 ]]; then
      grep -oP '<a class="group relative block" aria-label="[^"]*" href="/[a-z]{2}/card/\d+">.*?</a>' "$html" |
        awk '!seen[$0]++' | while IFS= read -r a; do
          local id nm src
          id=$(grep -oP 'href="/[a-z]{2}/card/\K\d+' <<<"$a")
          nm=$(grep -oP 'aria-label="\K[^"]*' <<<"$a")
          src=$(grep -oP '<img[^>]*src="\K[^"]+' <<<"$a" | head -1)
          [[ -n $src && ! -s $dir/$id ]] || continue
          "$CURL_BIN" -sS -m 20 "${BROWSER[@]}" -H "Referer: $SITE/$LOCALE/anime/$slug" -o "$dir/$id" "$src" 2>/dev/null &&
            printf '%s\t%s\n' "$nm" "$dir/$id"
        done >"$dir/list"
    fi
    rm -f "$html"
    "$CURL_BIN" -sS -m 30 "${BROWSER[@]}" -H "$(cookie_header)" -H "Referer: $SITE/$LOCALE/quiz" --compressed \
      -o "$dir/quiz" "$SITE/api/quiz/image?d=$(jq -r .day <<<"$QUIZ_STATE")&s=$(( tries < 2 ? tries : 2 ))" 2>/dev/null
    match=""
    [[ -s $dir/list && -s $dir/quiz ]] && match=$(quiz_match "$dir/quiz" "$dir/list" 2>/dev/null)
    rm -rf "$dir"
    IFS=$'\t' read -r name dist second ratio <<<"$match"
    if [[ -z $name ]] || ! awk -v r="${ratio:-0}" 'BEGIN { exit !(r >= 2) }'; then
      state_set QUIZ_ASKED "$today"
      warn "quiz: not sure (${name:-no candidate}${second:+ or $second}), left for you"
      discord_text "\"Who is it?\" needs you today: the anime is **$hint**. $([[ -n $name ]] && echo "Best guesses: $name or $second." || echo "No candidate found.") One try left, finish it on the site."
      rm -f "$QUIZ_HTML"; return 0
    fi
    log "quiz: anime \"$hint\", picture matches $name (${ratio}x closer than $second)"
    idle "$(rand 6 15)"
    quiz_guess "$name"; rc=$?
    played=1
    (( rc == 3 )) && { rm -f "$QUIZ_HTML"; return 3; }
    (( rc == 1 )) && { rm -f "$QUIZ_HTML"; return 0; }
  fi
  rm -f "$QUIZ_HTML"

  if (( played )) && [[ $(jq -r .finished <<<"$QUIZ_STATE") == true ]]; then
    state_set GAME_quiz_DAY "$today"
    if [[ $(jq -r '.solved // .correct' <<<"$QUIZ_STATE") == true ]]; then
      state_set GAME_quiz_RESULT "$(jq -r '"found \(.answer.name // ""), +\(.gems // 0) gems"' <<<"$QUIZ_STATE")"
      ok "quiz: $(state_get GAME_quiz_RESULT "")"
      GAMES_SUMMARY+="${GAMES_SUMMARY:+; }quiz $(state_get GAME_quiz_RESULT "")"
    else
      state_set GAME_quiz_RESULT "missed"
      warn "quiz: missed, the answer was $(jq -r '.answer.name // "?"' <<<"$QUIZ_STATE")"
      discord_text "\"Who is it?\" was missed today: the answer was $(jq -r '.answer.name // "?"' <<<"$QUIZ_STATE"). The streak starts over."
    fi
  fi
  return 0
}

