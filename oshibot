sb_get() {
  "$CURL_BIN" -sS -m 30 "${BROWSER[@]}" -H "apikey: $APIKEY" -H "Authorization: Bearer $(jq -r .access_token "$SESSION")" \
    -H 'Accept: application/json' -H "Origin: $SITE" -H "Referer: $SITE/" "$SUPABASE/rest/v1/$1" 2>/dev/null
}

sb_rpc() {
  http_post "$SUPABASE/rest/v1/rpc/$1" "$2" "${BROWSER[@]}" -H "apikey: $APIKEY" \
    -H "Authorization: Bearer $(jq -r .access_token "$SESSION")" -H 'content-profile: public' \
    -H "Origin: $SITE" -H "Referer: $SITE/"
  [[ $HTTP_STATUS == 2* ]]
}

# Duplicates that may go: common and uncommon only, numbered above 100. The site never offers a
# card's best copy, a locked copy or one on sale. Prints "copy<TAB>card<TAB>number<TAB>rarity<TAB>name".
SPARE_HTML=""
spare_copies() {
  visit_page "/$LOCALE/exchange"
  SPARE_HTML=$PAGE_HTML
  [[ $PAGE_CODE == 200 ]] || return 1
  page_stream "$SPARE_HTML" | grep -oP '"candidates":\K\{.*?\}(?=,"cardBack")' | head -1 |
    jq -r '("common", "uncommon") as $r | (.[$r] // [])[] | . as $c | .copies[] | select(.print_no > 100)
      | [.id, $c.card_id, .print_no, $r, $c.name] | @tsv' 2>/dev/null | shuf
}

# the rarity of each spare copy, read from the same page
spare_rarity() {
  page_stream "$SPARE_HTML" | grep -oP '"candidates":\K\{.*?\}(?=,"cardBack")' | head -1 |
    jq -r --arg r "$1" '(.[$r] // [])[] | .copies[] | select(.print_no > 100) | .id' 2>/dev/null
}

mission_banner() {
  local body key
  idle "$(rand 3 8)"
  http_post "$SITE/api/open" \
    "$(jq -nc --arg id "$(cat /proc/sys/kernel/random/uuid)" '{slug:"weekly", quantity:1, maxGems:0, requestId:$id}')" \
    "${BROWSER[@]}" -H "$(cookie_header)" -H 'Accept: */*' \
    -H "Origin: $SITE" -H "Referer: $SITE/$LOCALE/open/weekly" \
    -H 'sec-fetch-dest: empty' -H 'sec-fetch-mode: cors' -H 'sec-fetch-site: same-origin'
  [[ $HTTP_STATUS == 403 || $HTTP_STATUS == 429 ]] && { halt "opening the banner pack answered HTTP $HTTP_STATUS"; return 3; }
  key=$(jq -r '.errorKey // empty' <<<"$HTTP_BODY" 2>/dev/null)
  if [[ $HTTP_STATUS != 200 || -n $key ]] || ! jq -e .result.boosters >/dev/null 2>&1 <<<"$HTTP_BODY"; then
    warn "mission banner: the free banner pack was refused (${key:-HTTP $HTTP_STATUS})"; return 1
  fi
  body=$HTTP_BODY
  if (( $(jq -r '.result.paid.gems // 0' <<<"$body") > 0 )); then
    halt "the banner pack was paid with gems"; return 3
  fi
  log "${B}banner pack${R}"
  print_cards "$body"
  printf '%s\t%s\t%s\n' "$(now)" "$(jq -r '[.result.boosters[].cards[].rarity] | join(",")' <<<"$body")" weekly >>"$HISTORY"
  jq -r '.result.boosters[].cards[] | [.card_id, .rarity, .name, (.series_title // "")] | @tsv' <<<"$body" 2>/dev/null | learn_cards
  local payload
  payload=$(loot_payload "$body")
  [[ -n $payload ]] && discord_send "$payload"
  MISSION_DONE+="${MISSION_DONE:+, }banner pack opened"
}

mission_wishlist() {
  local id try
  visit_page "/$LOCALE/collection?filter=missing"
  for id in $(grep -oP 'href="/[a-z]{2}/card/\K\d+' "$PAGE_HTML" | awk '!s[$0]++' | shuf -n 3); do
    idle "$(rand 2 6)"
    call_action toggleWishlistAction "/$LOCALE/collection?filter=missing" "[$id]" "$PAGE_HTML" || continue
    if [[ $(jq -r '.wished' <<<"$ACT_BODY" 2>/dev/null) == true ]]; then
      rm -f "$PAGE_HTML"; MISSION_DONE+="${MISSION_DONE:+, }card $id wished"; return 0
    fi
    # it was already wished: put it back
    call_action toggleWishlistAction "/$LOCALE/collection?filter=missing" "[$id]" "$PAGE_HTML"
  done
  rm -f "$PAGE_HTML"
  warn "mission wishlist: no card could be added"; return 1
}

mission_chat() {
  local msg
  if [[ -z $MISSION_FRIEND ]]; then
    warn "mission chat: no friend set (run: oshibot friend <username>)"; return 1
  fi
  msg=$(shuf -n1 -e "salut !" "yo" "hello" "ça va ?" "bonne journée" "wesh" "coucou" "gg pour tes tirages")
  visit_page "/$LOCALE/friends/$MISSION_FRIEND"
  [[ $PAGE_CODE == 200 ]] || { rm -f "$PAGE_HTML"; warn "mission chat: conversation with $MISSION_FRIEND unreachable ($PAGE_CODE)"; return 1; }
  idle "$(rand 5 15)"
  if ! call_action sendChatMessageAction "/$LOCALE/friends/$MISSION_FRIEND" \
      "$(jq -nc --arg u "$MISSION_FRIEND" --arg m "$msg" '[$u, $m, null, null, null, null]')" "$PAGE_HTML" ||
      [[ -n $(jq -r '.error // empty' <<<"$ACT_BODY" 2>/dev/null) ]]; then
    rm -f "$PAGE_HTML"; warn "mission chat: message refused ($(jq -r '.error // empty' <<<"$ACT_BODY" 2>/dev/null))"; return 1
  fi
  rm -f "$PAGE_HTML"
  MISSION_DONE+="${MISSION_DONE:+, }message \"$msg\" sent to $MISSION_FRIEND"
}

mission_auction() {
  local feed row id price name
  feed=$(sb_get "auction_feed?select=id,price,current_bid,bids_count,name,rarity,is_mine,i_lead&is_mine=eq.false&order=price.asc&limit=10")
  row=$(jq -c --argjson max "$AUCTION_MAX_GEMS" '[.[] | select(.i_lead != true and .price <= $max)] | first // empty' <<<"$feed" 2>/dev/null)
  [[ -n $row ]] || { warn "mission auction: no auction under $AUCTION_MAX_GEMS gems"; return 1; }
  id=$(jq -r .id <<<"$row"); name=$(jq -r .name <<<"$row")
  sb_rpc auction_detail "$(jq -nc --argjson i "$id" '{p_auction_id:$i}')" || { warn "mission auction: auction $id unreadable"; return 1; }
  price=$(jq -r '.min_bid // empty' <<<"$HTTP_BODY" 2>/dev/null)
  [[ $price =~ ^[0-9]+$ ]] || price=$(jq -r .price <<<"$row")
  (( price <= AUCTION_MAX_GEMS )) || { warn "mission auction: minimum bid $price is above $AUCTION_MAX_GEMS gems"; return 1; }
  visit_page "/$LOCALE/market?tab=auctions"
  idle "$(rand 4 10)"
  if ! call_action placeBidAction "/$LOCALE/market?tab=auctions" "[$id, $price]" "$PAGE_HTML" ||
      [[ -n $(jq -r '.error // empty' <<<"$ACT_BODY" 2>/dev/null) ]]; then
    rm -f "$PAGE_HTML"; warn "mission auction: bid refused ($(jq -r '.error // empty' <<<"$ACT_BODY" 2>/dev/null))"; return 1
  fi
  rm -f "$PAGE_HTML"
  MISSION_DONE+="${MISSION_DONE:+, }bid $price gems on $name"
}

mission_sell() {
  local copy card num _r name price list
  list=$(mktemp)
  spare_copies >"$list"
  IFS=$'\t' read -r copy card num _r name <"$list"
  rm -f "$list"
  [[ -n $copy ]] || { rm -f "$SPARE_HTML"; warn "mission sell: no spare common or uncommon copy"; return 1; }
  sb_rpc market_price_stats "$(jq -nc --argjson c "$card" --argjson n "$num" --argjson i "$copy" '{p_card_id:$c, p_print_no:$n, p_copy_id:$i}')"
  price=$(jq -r '.suggested // empty' <<<"$HTTP_BODY" 2>/dev/null)
  [[ $price =~ ^[0-9]+$ ]] && (( price > 0 )) || price=$(jq -r '.min_allowed // 2' <<<"$HTTP_BODY" 2>/dev/null)
  rm -f "$SPARE_HTML"
  visit_page "/$LOCALE/market?tab=sell"
  idle "$(rand 4 10)"
  if ! call_action createListingAction "/$LOCALE/market?tab=sell" "$(jq -nc --argjson i "$copy" --argjson p "$price" '[$i, $p, 48, false]')" "$PAGE_HTML" ||
      [[ -n $(jq -r '.error // empty' <<<"$ACT_BODY" 2>/dev/null) ]]; then
    rm -f "$PAGE_HTML"; warn "mission sell: listing refused (HTTP $ACT_STATUS $(jq -r '.error // empty' <<<"$ACT_BODY" 2>/dev/null))"; return 1
  fi
  rm -f "$PAGE_HTML"
  MISSION_DONE+="${MISSION_DONE:+, }$name #$num listed for $price gems"
