log()  { echo "${DIM}$(date +%H:%M:%S)${R} $*"; }
ok()   { log "${GRN}OK${R} $*"; }
warn() { log "${YEL}!${R} $*"; }
err()  { log "${RED}ERROR${R} $*" >&2; }
die()  { err "$*"; exit 1; }
rand() { shuf -i "$1-$2" -n 1; }
now()  { date +%s; }
hhmm() { printf '%02d:%02d' $(( ($1 % 1440 + 1440) % 1440 / 60 )) $(( ($1 % 1440 + 1440) % 60 )); }

state_get() {
  local v=""
  [[ -f $STATE ]] && v=$(grep -m1 "^$1=" "$STATE" | cut -d= -f2-)
  echo "${v:-$2}"
}

state_set() {
  { [[ -f $STATE ]] && grep -v "^$1=" "$STATE"; echo "$1=$2"; } >"$STATE.tmp"
  mv "$STATE.tmp" "$STATE"
}

# stock size and refill rate of this account, learned from the site's answers
max_packs() { state_get FREE_MAX "$DEFAULT_MAX_PACKS"; }
regen_minutes() { state_get FREE_REGEN 10; }

learn_stock() {
  local max regen
  max=$(jq -r '.result.state.free_max // empty' <<<"$1")
  regen=$(jq -r '.result.state.free_regen_minutes // empty' <<<"$1")
  if [[ $max =~ ^[1-9][0-9]*$ && $max != "$(state_get FREE_MAX "")" ]]; then
    state_set FREE_MAX "$max"
    log "free stock on this account: up to $max boosters"
  fi
  [[ $regen =~ ^[1-9][0-9]*$ && $regen != "$(state_get FREE_REGEN "")" ]] && state_set FREE_REGEN "$regen"
  return 0
}

http_post() {
  local url=$1 body=$2 out
  shift 2
  if ! out=$("$CURL_BIN" -sS -m 30 -H 'Content-Type: application/json' "$@" \
      -d "$body" -w $'\n%{http_code}' "$url" 2>/dev/null); then
    HTTP_STATUS=000; HTTP_BODY=""; return
  fi
  HTTP_STATUS=${out##*$'\n'}
  HTTP_BODY=${out%$'\n'*}
}

